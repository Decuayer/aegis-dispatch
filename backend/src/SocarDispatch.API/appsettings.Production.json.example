{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=socar_dispatch_db;Port=5432;Database=socar_dispatch_prod;Username=postgres;Password=your_prod_password;Pooling=true;MinPoolSize=10;MaxPoolSize=100;Connection Idle Lifetime=300;"
  },
  "Redis": {
    "ConnectionString": "socar_dispatch_redis:6379"
  },
  "Minio": {
    "Endpoint": "socar_dispatch_storage:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "miniopassword",
    "BucketName": "socar-dispatch-media",
    "FeedbackBucketName": "socar-dispatch-feedbacks",
    "UseSSL": true,
    "PublicEndpoint": "https://storage.socar.local"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_STRONG_RANDOM_SECRET_KEY_MIN_32_BYTES",
    "Issuer": "socar-dispatch-prod-api",
    "Audience": "socar-dispatch-clients"
  },
  "AllowedHosts": "*"
}
