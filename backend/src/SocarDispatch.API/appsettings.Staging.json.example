{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=socar_dispatch_db;Port=5432;Database=socar_dispatch_staging;Username=postgres;Password=your_staging_password;Pooling=true;MinPoolSize=5;MaxPoolSize=50;Connection Idle Lifetime=300;"
  },
  "Redis": {
    "ConnectionString": "socar_dispatch_redis:6379"
  },
  "Minio": {
    "Endpoint": "socar_dispatch_storage:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "miniopassword",
    "BucketName": "socar-dispatch-media",
    "FeedbackBucketName": "socar-dispatch-feedbacks",
    "UseSSL": false,
    "PublicEndpoint": "http://staging-storage.socar.local:9000"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_STRONG_RANDOM_SECRET_KEY_MIN_32_BYTES",
    "Issuer": "socar-dispatch-staging-api",
    "Audience": "socar-dispatch-clients"
  },
  "AllowedHosts": "*"
}
