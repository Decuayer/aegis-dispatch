# ==============================================================================
# SOCAR Dispatch — Environment Variables Configuration
# ==============================================================================

# API & Gateway Configuration
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
WEB_PORT=5000
HTTP_PORT=80
HTTPS_PORT=443

# Database (PostgreSQL 16 + PostGIS)
POSTGRES_DB=socar_dispatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=socar_dispatch;Username=postgres;Password=postgrespassword

# Distributed Caching & Telemetry (Redis)
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_CONNECTION_STRING=redis:6379

# S3 Object Storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=socar-dispatch-media
MINIO_FEEDBACK_BUCKET=socar-dispatch-feedbacks
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Security & Authentication (JWT)
JWT_SECRET=SOCAR_Super_Secret_Key_For_Emergency_Dispatch_System_2026
JWT_ISSUER=socar-dispatch-api
JWT_AUDIENCE=socar-dispatch-clients
