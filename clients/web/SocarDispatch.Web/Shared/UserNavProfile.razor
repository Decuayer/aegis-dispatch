@using System.Security.Claims
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized Context="authContext">
        <div class="nav-profile">
            <div class="nav-profile-avatar">
                @GetUserInitials(authContext.User)
            </div>
            <div class="nav-profile-info">
                <span class="nav-profile-name">@GetUserName(authContext.User)</span>
                <span class="badge-role">Operator</span>
            </div>
            <button class="btn btn-danger-ghost nav-signout-btn" @onclick="HandleLogout" title="Sign out">
                <!-- Logout icon -->
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Sign Out
            </button>
        </div>
    </Authorized>
</AuthorizeView>

<style>
    .nav-profile {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .nav-profile-avatar {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background-color: var(--color-accent);
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        letter-spacing: 0.3px;
    }

    .nav-profile-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .nav-profile-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text-primary);
        line-height: 1;
    }

    .nav-signout-btn {
        padding: 6px 10px;
        font-size: 12px;
        gap: 5px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        white-space: nowrap;
    }
</style>

@code {
    private string GetUserName(ClaimsPrincipal user)
    {
        var name = user.FindFirst(ClaimTypes.Name)?.Value
                ?? user.FindFirst("name")?.Value
                ?? user.Identity?.Name;
        return !string.IsNullOrWhiteSpace(name) ? name : "Operator";
    }

    private string GetUserInitials(ClaimsPrincipal user)
    {
        var name = GetUserName(user);
        if (string.IsNullOrWhiteSpace(name)) return "OP";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login");
    }
}
