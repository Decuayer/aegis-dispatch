@* Components/Map/MapEntityFocusBar.razor *@
@using SocarDispatch.Web.Models.Map

<div class="map-focus-bar-container">
    <div class="search-input-wrapper">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text"
               class="search-input"
               placeholder="Search incident, team, code..."
               value="@_searchQuery"
               @oninput="HandleSearchInput"
               @onfocus="() => _isDropdownOpen = true"
               @onkeydown="HandleKeyDown" />
        @if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            <button type="button" class="btn-clear" @onclick="ClearSearch" title="Clear search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        }
    </div>

    @if (_isDropdownOpen && !string.IsNullOrWhiteSpace(_searchQuery))
    {
        <div class="focus-dropdown">
            @if (FilteredResults.Any())
            {
                @foreach (var item in FilteredResults)
                {
                    <div class="focus-item" @onclick="() => SelectEntity(item)">
                        <div class="item-left">
                            <span class="entity-badge badge-@item.Type.ToLower() badge-@item.SeverityClass.ToLower()">@item.BadgeText</span>
                            <div class="entity-info">
                                <strong class="entity-title">@item.Title</strong>
                                <span class="entity-sub">@item.Subtitle</span>
                            </div>
                        </div>
                        <span class="entity-action-hint">Focus →</span>
                    </div>
                }
            }
            else
            {
                <div class="focus-empty">
                    <p>No matching incidents or teams found.</p>
                </div>
            }
        </div>
    }
</div>

@if (_isDropdownOpen)
{
    <div class="focus-backdrop" @onclick="CloseDropdown"></div>
}

@code {
    [Parameter] public List<MapIncidentDto> Incidents { get; set; } = new();
    [Parameter] public List<MapTeamDto> Teams { get; set; } = new();
    [Parameter] public EventCallback<Guid> OnIncidentFocused { get; set; }
    [Parameter] public EventCallback<Guid> OnTeamFocused { get; set; }

    private string _searchQuery = "";
    private bool _isDropdownOpen = false;

    private IEnumerable<SearchResultItem> FilteredResults
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchQuery))
                return Enumerable.Empty<SearchResultItem>();

            var query = _searchQuery.Trim().ToLowerInvariant();
            var results = new List<SearchResultItem>();

            // Incidents matching
            foreach (var inc in Incidents)
            {
                if (inc.Status is "Resolved" or "Canceled") continue;

                if (inc.Category.ToLowerInvariant().Contains(query) ||
                    inc.EmergencyCode.ToLowerInvariant().Contains(query) ||
                    inc.ReporterFullName.ToLowerInvariant().Contains(query) ||
                    (inc.AssignedTeamName?.ToLowerInvariant().Contains(query) ?? false))
                {
                    results.Add(new SearchResultItem
                    {
                        Id = inc.Id,
                        Type = "Incident",
                        BadgeText = inc.EmergencyCode,
                        SeverityClass = inc.EmergencyCode.ToLowerInvariant(),
                        Title = inc.Category,
                        Subtitle = $"{inc.ReporterFullName} • {inc.Status}" + (string.IsNullOrWhiteSpace(inc.AssignedTeamName) ? "" : $" • {inc.AssignedTeamName}")
                    });
                }
            }

            // Teams matching
            foreach (var team in Teams)
            {
                if (team.TeamName.ToLowerInvariant().Contains(query) ||
                    team.Status.ToLowerInvariant().Contains(query))
                {
                    results.Add(new SearchResultItem
                    {
                        Id = team.Id,
                        Type = "Team",
                        BadgeText = team.Status,
                        SeverityClass = team.Status.ToLowerInvariant(),
                        Title = team.TeamName,
                        Subtitle = $"Response Team • Status: {team.Status}"
                    });
                }
            }

            return results.Take(8);
        }
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        _isDropdownOpen = true;
    }

    private async Task SelectEntity(SearchResultItem item)
    {
        _isDropdownOpen = false;
        if (item.Type == "Incident")
        {
            await OnIncidentFocused.InvokeAsync(item.Id);
        }
        else if (item.Type == "Team")
        {
            await OnTeamFocused.InvokeAsync(item.Id);
        }
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _isDropdownOpen = false;
    }

    private void CloseDropdown()
    {
        _isDropdownOpen = false;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ClearSearch();
        }
    }

    private class SearchResultItem
    {
        public Guid Id { get; set; }
        public string Type { get; set; } = string.Empty; // "Incident" or "Team"
        public string BadgeText { get; set; } = string.Empty;
        public string SeverityClass { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Subtitle { get; set; } = string.Empty;
    }
}

<style>
    .map-focus-bar-container {
        position: relative;
        width: 320px;
        z-index: 1010;
    }

    .search-input-wrapper {
        display: flex;
        align-items: center;
        background: var(--color-surface, #1c1f26);
        border: 1px solid var(--color-border, #2e3138);
        border-radius: 8px;
        padding: 6px 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(8px);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .search-input-wrapper:focus-within {
        border-color: var(--color-accent, #3b82f6);
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.25), 0 6px 20px rgba(0, 0, 0, 0.4);
    }

    .search-icon {
        color: var(--color-text-muted, #8b909a);
        margin-right: 8px;
        flex-shrink: 0;
    }

    .search-input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: var(--color-text-primary, #f0f2f5);
        font-size: 13px;
        font-family: inherit;
    }

    .search-input::placeholder {
        color: var(--color-text-subtle, #5c606a);
    }

    .btn-clear {
        background: transparent;
        border: none;
        color: var(--color-text-muted, #8b909a);
        cursor: pointer;
        padding: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        transition: color 0.15s ease;
    }

    .btn-clear:hover {
        color: var(--color-text-primary, #f0f2f5);
    }

    .focus-dropdown {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        background: var(--color-surface, #1c1f26);
        border: 1px solid var(--color-border, #2e3138);
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        max-height: 360px;
        overflow-y: auto;
        z-index: 1020;
    }

    .focus-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
        cursor: pointer;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        transition: background-color 0.15s ease;
    }

    .focus-item:last-child {
        border-bottom: none;
    }

    .focus-item:hover {
        background-color: var(--color-surface-2, #252930);
    }

    .item-left {
        display: flex;
        align-items: center;
        gap: 8px;
        overflow: hidden;
    }

    .entity-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        flex-shrink: 0;
    }

    /* Badge Color Variations */
    .badge-incident { background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4); }
    .badge-team { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }
    .badge-team.badge-idle { background: rgba(34, 197, 94, 0.2); color: #22c55e; border-color: rgba(34, 197, 94, 0.4); }
    .badge-team.badge-busy { background: rgba(239, 68, 68, 0.2); color: #ef4444; border-color: rgba(239, 68, 68, 0.4); }

    .entity-info {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .entity-title {
        font-size: 12px;
        color: var(--color-text-primary, #f0f2f5);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .entity-sub {
        font-size: 11px;
        color: var(--color-text-muted, #8b909a);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .entity-action-hint {
        font-size: 11px;
        color: var(--color-accent, #3b82f6);
        font-weight: 600;
        opacity: 0;
        transform: translateX(-4px);
        transition: all 0.15s ease;
    }

    .focus-item:hover .entity-action-hint {
        opacity: 1;
        transform: translateX(0);
    }

    .focus-empty {
        padding: 16px;
        text-align: center;
        color: var(--color-text-muted, #8b909a);
        font-size: 12px;
    }

    .focus-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1005;
    }
</style>
