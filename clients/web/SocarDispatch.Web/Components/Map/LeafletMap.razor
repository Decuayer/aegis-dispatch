@* Components/Map/LeafletMap.razor *@
@using SocarDispatch.Web.Services.SignalR
@using SocarDispatch.Web.Events
@using SocarDispatch.Web.Models.Map
@using SocarDispatch.Web.Models.Settings
@inject IMapService MapService
@inject IIncidentHubClient IncidentHub
@inject ILocationHubClient LocationHub
@inject HttpClient Http
@inject IJSRuntime JS
@inject IToastService ToastService
@inject ISettingsService SettingsService
@implements IAsyncDisposable

<div class="leaflet-map-wrapper" id="@_containerId" style="height: @Height; width: 100%;"></div>

@code {
    private readonly string _containerId = $"leaflet-map-{Guid.NewGuid():N}";
    private DotNetObjectReference<LeafletMap>? _dotNetRef;
    private UserPreferencesDto? _cachedPreferences;

    [Parameter] public string Height { get; set; } = "560px";

    // Callback events from map popups
    [Parameter] public EventCallback<Guid> OnIncidentDetailRequested { get; set; }
    [Parameter] public EventCallback<Guid> OnAssignTeamRequested { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 1. Initialize map with settings preferences
        _cachedPreferences = await SettingsService.GetPreferencesAsync();
        await MapService.InitializeMapAsync(
            _containerId, 
            _cachedPreferences.DefaultLatitude, 
            _cachedPreferences.DefaultLongitude, 
            _cachedPreferences.DefaultZoom, 
            _cachedPreferences.TileProvider ?? "OpenStreetMap");
        
        // Apply facility boundary lock if enabled in user preferences
        if (_cachedPreferences.LockMapToFacilityBoundary)
        {
            await MapService.SetMapBoundaryLockAsync(true);
        }

        // 2. Connect DotNet reference for popup button interop
        _dotNetRef = DotNetObjectReference.Create(this);
        await MapService.SetDotNetReferenceAsync(_dotNetRef);

        // 3. Load initial active incidents and teams
        await LoadIncidentsAsync();
        await LoadTeamsAsync();

        // 4. SignalR event subscriptions
        SubscribeToHubEvents();
        await IncidentHub.StartAsync();
        await LocationHub.StartAsync();
    }

    // ──────────────────────────────────────────────
    // Public Map Control Methods (Invoked via @ref)
    // ──────────────────────────────────────────────

    public async Task PanToIncidentAsync(Guid incidentId)
        => await MapService.PanToIncidentAsync(incidentId);

    public async Task PanToTeamAsync(Guid teamId)
        => await MapService.PanToTeamAsync(teamId);

    public async Task PanToLocationAsync(double lat, double lng, int zoom = 15)
        => await MapService.PanToLocationAsync(lat, lng, zoom);
    
    public async Task FocusMarkerByIdAsync(string entityType, Guid entityId, int zoomLevel = 17)
        => await MapService.FocusMarkerByIdAsync(entityType, entityId, zoomLevel);

    public async Task ToggleIncidentsLayerAsync(bool visible)
        => await MapService.ToggleIncidentsLayerAsync(visible);

    public async Task ToggleResolvedIncidentsLayerAsync(bool visible)
        => await MapService.ToggleResolvedIncidentsLayerAsync(visible);

    public async Task ToggleTeamsLayerAsync(bool visible)
        => await MapService.ToggleTeamsLayerAsync(visible);

    public async Task ChangeTileLayerAsync(string tileProvider)
        => await MapService.UpdateMainTileLayerAsync(tileProvider);
    
    public async Task SetBoundaryLockAsync(bool enabled, MapBoundsDto? bounds = null)
        => await MapService.SetMapBoundaryLockAsync(enabled, bounds);

    public async Task InvalidateSizeAsync()
        => await MapService.InvalidateSizeAsync();

    public async Task ResetViewAsync()
    {
        var prefs = _cachedPreferences ?? await SettingsService.GetPreferencesAsync();
        await MapService.PanToLocationAsync(prefs.DefaultLatitude, prefs.DefaultLongitude, prefs.DefaultZoom);
    }

    // ──────────────────────────────────────────────
    // REST API — Initial Data Fetching
    // ──────────────────────────────────────────────

    public async Task LoadIncidentsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<PagedResult<MapIncidentDto>>>("api/v1/incidents?pageSize=1000");
            if (response?.Data?.Items != null)
            {
                foreach (var incident in response.Data.Items)
                {
                    await MapService.AddIncidentMarkerAsync(incident);
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[LeafletMap] Failed to load initial incidents: {ex.Message}");
        }
    }

    public async Task LoadTeamsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<PagedResult<MapTeamDto>>>("api/v1/teams?pageSize=100");
            if (response?.Data?.Items != null)
            {
                foreach (var team in response.Data.Items)
                {
                    await MapService.AddTeamMarkerAsync(team);
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[LeafletMap] Failed to load initial teams: {ex.Message}");
        }
    }

    // ──────────────────────────────────────────────
    // SignalR — Real-time Event Management
    // ──────────────────────────────────────────────

    private void SubscribeToHubEvents()
    {
        IncidentHub.OnNewIncidentReceived += HandleNewIncident;
        IncidentHub.OnIncidentStatusChanged += HandleIncidentStatusChanged;
        IncidentHub.OnIncidentUpdated += HandleIncidentUpdatedRealtime;
        IncidentHub.OnTeamDispatched += HandleTeamDispatched;
        LocationHub.OnTeamLocationUpdated += HandleTeamLocationUpdated;
    }

    private void UnsubscribeFromHubEvents()
    {
        IncidentHub.OnNewIncidentReceived -= HandleNewIncident;
        IncidentHub.OnIncidentStatusChanged -= HandleIncidentStatusChanged;
        IncidentHub.OnIncidentUpdated -= HandleIncidentUpdatedRealtime;
        IncidentHub.OnTeamDispatched -= HandleTeamDispatched;
        LocationHub.OnTeamLocationUpdated -= HandleTeamLocationUpdated;
    }

    private async void HandleIncidentUpdatedRealtime(object? sender, IncidentUpdatedEventArgs e)
    {
        var incident = new MapIncidentDto
        {
            Id = e.IncidentId,
            Category = e.Category,
            EmergencyCode = e.EmergencyCode,
            ReporterFullName = "Incident Report",
            Status = "Open",
            Latitude = (decimal)e.Latitude,
            Longitude = (decimal)e.Longitude,
            CreatedAt = e.UpdatedAt
        };
        await InvokeAsync(async () =>
        {
            await MapService.AddIncidentMarkerAsync(incident);
        });
    }

    private async void HandleNewIncident(object? sender, NewIncidentReceivedEventArgs e)
    {
        ToastService.ShowEmergencyAlert(e.Category, e.EmergencyCode, e.ReporterFullName);

        var incident = new MapIncidentDto
        {
            Id = e.Id,
            Category = e.Category,
            EmergencyCode = e.EmergencyCode,
            ReporterFullName = e.ReporterFullName ?? "Unknown",
            Status = "Open",
            Latitude = (decimal)e.Latitude,
            Longitude = (decimal)e.Longitude,
            CreatedAt = e.CreatedAt
        };

        await InvokeAsync(async () =>
        {
            await MapService.AddIncidentMarkerAsync(incident);
        });
    }

    private async void HandleIncidentStatusChanged(object? sender, IncidentStatusChangedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await MapService.UpdateIncidentStatusAsync(e.IncidentId, e.Status);
        });
    }

    private async void HandleTeamDispatched(object? sender, TeamDispatchedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await MapService.UpdateIncidentAssignmentAsync(e.IncidentId, e.TeamId, "Assigned Team");
            await MapService.UpdateTeamStatusAsync(e.TeamId, "Forwarded");
            await MapService.UpdateIncidentStatusAsync(e.IncidentId, "Assigned");
        });
    }

    private async void HandleTeamLocationUpdated(object? sender, TeamLocationUpdatedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await MapService.AnimateTeamMarkerAsync(e.TeamId, e.Latitude, e.Longitude);
        });
    }

    // ──────────────────────────────────────────────
    // JS → C# Interop Callbacks (Popup Buttons)
    // ──────────────────────────────────────────────

    [JSInvokable]
    public async Task NotifyIncidentDetail(string incidentIdStr)
    {
        if (Guid.TryParse(incidentIdStr, out var id))
            await OnIncidentDetailRequested.InvokeAsync(id);
    }

    [JSInvokable]
    public async Task NotifyAssignTeam(string incidentIdStr)
    {
        if (Guid.TryParse(incidentIdStr, out var id))
            await OnAssignTeamRequested.InvokeAsync(id);
    }

    // ──────────────────────────────────────────────
    // Resource Cleanup
    // ──────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        UnsubscribeFromHubEvents();
        await MapService.DestroyMapAsync();
        _dotNetRef?.Dispose();
    }
}

<style>
    .leaflet-map-wrapper {
        height: 100%;
        min-height: 100%;
        width: 100%;
        background-color: var(--color-bg, #111318);
        border-radius: inherit;
        overflow: hidden;
    }
</style>
