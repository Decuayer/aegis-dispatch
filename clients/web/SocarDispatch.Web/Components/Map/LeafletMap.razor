@* Components/Map/LeafletMap.razor *@
@using SocarDispatch.Web.Services.SignalR
@using SocarDispatch.Web.Events
@inject IMapService MapService
@inject IIncidentHubClient IncidentHub
@inject ILocationHubClient LocationHub
@inject HttpClient Http
@inject IJSRuntime JS
@inject IToastService ToastService
@inject ISettingsService SettingsService
@implements IAsyncDisposable

<div class="leaflet-map-wrapper" id="@_containerId" style="height: @Height; width: 100%;"></div>

@code {
    private readonly string _containerId = $"leaflet-map-{Guid.NewGuid():N}";
    private DotNetObjectReference<LeafletMap>? _dotNetRef;

    [Parameter] public string Height { get; set; } = "560px";

    // Harita popup butonlarından Blazor'a gelen geri çağırma eventleri
    [Parameter] public EventCallback<Guid> OnIncidentDetailRequested { get; set; }
    [Parameter] public EventCallback<Guid> OnAssignTeamRequested { get; set; }

        protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 1. Initialize the map with the coordinates and zoom level read from the settings.
        var prefs = await SettingsService.GetPreferencesAsync();
        await MapService.InitializeMapAsync(_containerId, prefs.DefaultLatitude, prefs.DefaultLongitude, prefs.DefaultZoom);

        // 2. Connect the DotNet reference
        _dotNetRef = DotNetObjectReference.Create(this);
        await MapService.SetDotNetReferenceAsync(_dotNetRef);

        // 3. Upload incident and teams
        await LoadIncidentsAsync();
        await LoadTeamsAsync();

        // 4. SignalR subscriptions and initialization
        SubscribeToHubEvents();
        await IncidentHub.StartAsync();
        await LocationHub.StartAsync();
    }

    // ──────────────────────────────────────────────
    // REST API — İlk Veri Yükleme
    // ──────────────────────────────────────────────
    private async Task LoadIncidentsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<List<MapIncidentDto>>>(
                "api/v1/incidents?status=Open");

            if (response?.Data != null)
            {
                foreach (var incident in response.Data)
                {
                    await MapService.AddIncidentMarkerAsync(incident);
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[LeafletMap] Failed to load initial incidents: {ex.Message}");
        }
    }

    private async Task LoadTeamsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<List<MapTeamDto>>>(
                "api/v1/teams");

            if (response?.Data != null)
            {
                foreach (var team in response.Data)
                {
                    await MapService.AddTeamMarkerAsync(team);
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[LeafletMap] Failed to load initial teams: {ex.Message}");
        }
    }

    // ──────────────────────────────────────────────
    // SignalR — Gerçek Zamanlı Event Yönetimi
    // ──────────────────────────────────────────────
    private void SubscribeToHubEvents()
    {
        IncidentHub.OnNewIncidentReceived += HandleNewIncident;
        IncidentHub.OnIncidentStatusChanged += HandleIncidentStatusChanged;
        IncidentHub.OnTeamDispatched += HandleTeamDispatched;
        LocationHub.OnTeamLocationUpdated += HandleTeamLocationUpdated;
    }

    private void UnsubscribeFromHubEvents()
    {
        IncidentHub.OnNewIncidentReceived -= HandleNewIncident;
        IncidentHub.OnIncidentStatusChanged -= HandleIncidentStatusChanged;
        IncidentHub.OnTeamDispatched -= HandleTeamDispatched;
        LocationHub.OnTeamLocationUpdated -= HandleTeamLocationUpdated;
    }

    private async void HandleNewIncident(object? sender, NewIncidentReceivedEventArgs e)
    {
        // 🚨 Sesli ve görsel toast bildirimini tetikle
        ToastService.ShowEmergencyAlert(e.Category, e.EmergencyCode, e.ReporterFullName);

        var incident = new MapIncidentDto
        {
            Id = e.Id,
            Category = e.Category,
            EmergencyCode = e.EmergencyCode,
            ReporterFullName = e.ReporterFullName ?? "Unknown",
            Status = "Open",
            Latitude = (decimal)e.Latitude,
            Longitude = (decimal)e.Longitude,
            CreatedAt = e.CreatedAt
        };

        await InvokeAsync(async () =>
        {
            await MapService.AddIncidentMarkerAsync(incident);
        });
    }

    private async void HandleIncidentStatusChanged(object? sender, IncidentStatusChangedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await MapService.UpdateIncidentStatusAsync(e.IncidentId, e.Status);
        });
    }

    private async void HandleTeamDispatched(object? sender, TeamDispatchedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await MapService.UpdateIncidentAssignmentAsync(e.IncidentId, e.TeamId, "Assigned Team");
        });
    }

    private async void HandleTeamLocationUpdated(object? sender, TeamLocationUpdatedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await MapService.AnimateTeamMarkerAsync(e.TeamId, e.Latitude, e.Longitude);
        });
    }

    // ──────────────────────────────────────────────
    // JS → C# Geri Çağırmalar (Popup Butonları)
    // ──────────────────────────────────────────────
    [JSInvokable]
    public async Task NotifyIncidentDetail(string incidentIdStr)
    {
        if (Guid.TryParse(incidentIdStr, out var id))
            await OnIncidentDetailRequested.InvokeAsync(id);
    }

    [JSInvokable]
    public async Task NotifyAssignTeam(string incidentIdStr)
    {
        if (Guid.TryParse(incidentIdStr, out var id))
            await OnAssignTeamRequested.InvokeAsync(id);
    }

    // ──────────────────────────────────────────────
    // Temizleme (Resource Cleanup)
    // ──────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        UnsubscribeFromHubEvents();
        await MapService.DestroyMapAsync();
        _dotNetRef?.Dispose();
    }
}
