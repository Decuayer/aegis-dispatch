@using System.Net.Http.Headers
@using Microsoft.Extensions.Configuration
@using Microsoft.JSInterop
@using SocarDispatch.Web.Models.Auth
@using SocarDispatch.Web.Models.Common
@using SocarDispatch.Web.Services
@inject IUserService UserService
@inject IToastService ToastService
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@implements IDisposable

<div class="settings-card">
    <div class="settings-card-header">
        <div>
            <h3 class="settings-card-title">Operator Profile & Identity</h3>
            <p class="settings-card-subtitle">View your dispatch credentials, update contact information, upload profile photo, or set an avatar URL.</p>
        </div>
    </div>

    <div class="settings-card-body">
        @if (_isLoading)
        {
            <div class="table-loading-state">
                <div class="spinner-sm"></div>
                <span>Loading profile details...</span>
            </div>
        }
        else if (_user != null)
        {
            <!-- Operator Badge & Avatar Management -->
            <div class="profile-overview-card">
                <div class="profile-avatar-container">
                    <div class="profile-avatar">
                        @if (!string.IsNullOrWhiteSpace(_formModel.AvatarUrl))
                        {
                            <img src="@_formModel.AvatarUrl" alt="Avatar" class="profile-avatar-img" onerror="this.style.display='none'" />
                        }
                        else
                        {
                            @GetInitials(_user.FirstName, _user.LastName)
                        }
                    </div>

                    @if (_isUploading)
                    {
                        <div class="avatar-upload-overlay">
                            <span class="spinner-sm"></span>
                        </div>
                    }
                </div>

                <div class="profile-info">
                    <div class="profile-name-row">
                        <h4>@_user.FirstName @_user.LastName</h4>
                        <span class="badge-role">@_user.RoleType</span>
                        @if (!string.IsNullOrEmpty(_user.SubRole))
                        {
                            <span class="badge-subrole">@_user.SubRole</span>
                        }
                    </div>
                    <div class="profile-email">@_user.Email</div>
                    <div class="profile-department">🏢 @_user.Department</div>
                </div>
            </div>

            <!-- Avatar Source Control (File Upload or Direct URL) -->
            <div class="avatar-source-box">
                <div class="avatar-source-header">
                    <span class="avatar-source-title">Profile Photo / Avatar</span>
                    @if (!string.IsNullOrWhiteSpace(_formModel.AvatarUrl))
                    {
                        <button type="button" class="btn-remove-avatar" @onclick="RemoveAvatar">
                            Remove Photo
                        </button>
                    }
                </div>

                <div class="avatar-upload-controls">
                    <!-- File Upload Input (Hidden + Styled Button) -->
                    <label class="btn btn-ghost btn-sm btn-upload-file">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                        </svg>
                        <span>Upload Photo File</span>
                        <InputFile OnChange="HandleFileSelectedAsync" accept="image/png,image/jpeg,image/webp" style="display:none;" />
                    </label>

                    <span class="text-subtle-color font-weight-500">or enter image URL:</span>

                    <!-- Direct URL Input -->
                    <input type="text" class="form-control form-control-sm avatar-url-input" 
                           placeholder="https://example.com/photo.jpg" 
                           @bind="_formModel.AvatarUrl" 
                           @bind:event="oninput" />
                </div>
            </div>

            <div class="divider-line"></div>

            <!-- Profile Edit Form -->
            <EditForm Model="@_formModel" OnValidSubmit="HandleProfileUpdateAsync">
                <DataAnnotationsValidator />
                <div class="settings-grid">
                    <!-- First Name -->
                    <div class="form-group">
                        <label class="form-label">First Name *</label>
                        <InputText class="form-control" @bind-Value="_formModel.FirstName" />
                        <ValidationMessage For="@(() => _formModel.FirstName)" class="validation-message" />
                    </div>

                    <!-- Last Name -->
                    <div class="form-group">
                        <label class="form-label">Last Name *</label>
                        <InputText class="form-control" @bind-Value="_formModel.LastName" />
                        <ValidationMessage For="@(() => _formModel.LastName)" class="validation-message" />
                    </div>

                    <!-- Phone Number -->
                    <div class="form-group">
                        <label class="form-label">Phone Number</label>
                        <InputText class="form-control" @bind-Value="_formModel.Phone" placeholder="+994 (XX) XXX-XX-XX" />
                        <ValidationMessage For="@(() => _formModel.Phone)" class="validation-message" />
                    </div>

                    <!-- Department -->
                    <div class="form-group">
                        <label class="form-label">Department *</label>
                        <InputText class="form-control" @bind-Value="_formModel.Department" placeholder="e.g. Emergency Response, Security" />
                        <ValidationMessage For="@(() => _formModel.Department)" class="validation-message" />
                    </div>

                    <!-- Sub-Role / Title -->
                    <div class="form-group">
                        <label class="form-label">Sub-Role / Title</label>
                        <InputText class="form-control" @bind-Value="_formModel.SubRole" placeholder="e.g. Senior Dispatcher, Shift Supervisor" />
                        <ValidationMessage For="@(() => _formModel.SubRole)" class="validation-message" />
                    </div>
                </div>

                <div class="settings-footer-action">
                    <button type="submit" class="btn btn-primary" disabled="@(_isSaving || _isUploading)">
                        @if (_isSaving)
                        {
                            <span class="spinner-sm"></span>
                            <span>Saving Changes...</span>
                        }
                        else
                        {
                            <span>Update Profile Info</span>
                        }
                    </button>
                </div>
            </EditForm>

            <div class="divider-line" style="margin: 2rem 0;"></div>

            <!-- Connected Accounts / Google Authentication Linking Section -->
            <div class="connected-accounts-section">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                    <div>
                        <h4 style="font-size: 1.1rem; font-weight: 600; color: var(--color-text-primary, #ffffff); margin: 0 0 0.25rem 0;">
                            Bağlı Hesaplar / Connected Accounts
                        </h4>
                        <p style="font-size: 0.85rem; color: var(--color-text-secondary, #94a3b8); margin: 0;">
                            Hesabınıza Google hesabınızı bağlayarak hem Web Panel'e hem Mobil Uygulamaya tek tıkla şifresiz giriş yapabilirsiniz.
                        </p>
                    </div>
                </div>

                <div class="connected-account-card" style="display: flex; align-items: center; justify-content: space-between; padding: 1.25rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08)); border-radius: 12px; gap: 1rem; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(255, 255, 255, 0.06); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <svg width="24" height="24" viewBox="0 0 24 24">
                                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                            </svg>
                        </div>
                        <div>
                            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.2rem;">
                                <span style="font-weight: 600; font-size: 0.95rem; color: var(--color-text-primary, #ffffff);">Google Hesabı</span>
                                @if (_user.IsGoogleLinked)
                                {
                                    <span style="display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.75rem; font-weight: 600; padding: 2px 8px; border-radius: 9999px; background: rgba(34, 197, 94, 0.15); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3);">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                        Bağlandı
                                    </span>
                                }
                                else
                                {
                                    <span style="font-size: 0.75rem; font-weight: 500; padding: 2px 8px; border-radius: 9999px; background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.25);">
                                        Bağlı Değil
                                    </span>
                                }
                            </div>
                            <div style="font-size: 0.85rem; color: var(--color-text-secondary, #94a3b8);">
                                @if (_user.IsGoogleLinked)
                                {
                                    <span>Bağlı e-posta: <strong style="color: var(--color-text-primary, #ffffff);">@_user.GoogleEmail</strong></span>
                                }
                                else
                                {
                                    <span>Google hesabınızı bağlayarak şifresiz oturum açabilirsiniz.</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div>
                        @if (_user.IsGoogleLinked)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="HandleUnlinkGoogleAsync" disabled="@_isGoogleActionInProgress" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 1rem; border-radius: 8px;">
                                @if (_isGoogleActionInProgress)
                                {
                                    <span class="spinner-sm"></span>
                                    <span>İşleniyor...</span>
                                }
                                else
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                    <span>Bağlantıyı Kaldır</span>
                                }
                            </button>
                        }
                        else
                        {
                            <div id="google-link-btn-container" style="min-height: 40px; min-width: 200px;">
                                @if (_isGoogleActionInProgress)
                                {
                                    <div class="spinner-sm"></div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private UserDto? _user;
    private UpdateUserProfileRequestDto _formModel = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isUploading;
    private bool _isGoogleActionInProgress;
    private DotNetObjectReference<ProfileSettingsSection>? _dotNetRef;
    private bool _jsInitialized;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && _user != null && !_user.IsGoogleLinked && !_jsInitialized)
        {
            _jsInitialized = true;
            await SetupGoogleLinkButtonAsync();
        }
    }

    private async Task SetupGoogleLinkButtonAsync()
    {
        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            var googleClientId = Configuration["Authentication:GoogleClientId"] 
                                 ?? Configuration["GoogleClientId"] 
                                 ?? string.Empty;

            await JSRuntime.InvokeVoidAsync("socarGoogleAuth.initLink", _dotNetRef, googleClientId, "google-link-btn-container");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[GoogleAuth] Link setup error: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnGoogleLinkSuccess(string idToken)
    {
        if (string.IsNullOrWhiteSpace(idToken)) return;

        _isGoogleActionInProgress = true;
        StateHasChanged();

        try
        {
            var response = await UserService.LinkGoogleAccountAsync(idToken);
            if (response != null && response.Success && response.Data != null)
            {
                _user = response.Data;
                ToastService.ShowSuccess($"Google hesabı ({_user.GoogleEmail}) başarıyla bağlandı.", "Google Hesabı Bağlandı");
            }
            else
            {
                ToastService.ShowError(response?.Message ?? "Google hesabı bağlanamadı.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Bağlantı hatası: {ex.Message}");
        }
        finally
        {
            _isGoogleActionInProgress = false;
            _jsInitialized = false; // Reset to allow re-render if unlinked later
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnGoogleLinkFailure(string error)
    {
        _isGoogleActionInProgress = false;
        ToastService.ShowError(error, "Google Bağlantı Hatası");
        StateHasChanged();
    }

    private async Task HandleUnlinkGoogleAsync()
    {
        _isGoogleActionInProgress = true;
        StateHasChanged();

        try
        {
            var response = await UserService.UnlinkGoogleAccountAsync();
            if (response != null && response.Success && response.Data != null)
            {
                _user = response.Data;
                _jsInitialized = false;
                ToastService.ShowSuccess("Google hesabı bağlantısı başarıyla kaldırıldı.", "Bağlantı Kaldırıldı");
                // Re-initialize Google link button on next render
                _ = Task.Delay(100).ContinueWith(async _ => 
                {
                    await InvokeAsync(SetupGoogleLinkButtonAsync);
                    await InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                ToastService.ShowError(response?.Message ?? "Google hesabı bağlantısı kaldırılamadı.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Hata: {ex.Message}");
        }
        finally
        {
            _isGoogleActionInProgress = false;
            StateHasChanged();
        }
    }

    private async Task LoadProfileAsync()
    {
        _isLoading = true;
        try
        {
            var response = await UserService.GetCurrentUserAsync();
            if (response != null && response.Success && response.Data != null)
            {
                _user = response.Data;
                _formModel = new UpdateUserProfileRequestDto
                {
                    FirstName = _user.FirstName,
                    LastName = _user.LastName,
                    Phone = _user.Phone,
                    Department = _user.Department,
                    SubRole = _user.SubRole,
                    AvatarUrl = _user.AvatarUrl
                };
            }
            else
            {
                ToastService.ShowError(response?.Message ?? "Failed to load user profile.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Limit size to 5MB
        if (file.Size > 5 * 1024 * 1024)
        {
            ToastService.ShowError("Photo file size must not exceed 5 MB.", "File Too Large");
            return;
        }

        _isUploading = true;
        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            
            content.Add(fileContent, "File", file.Name);
            content.Add(new StringContent("avatar"), "Category");

            var response = await Http.PostAsync("api/v1/media/upload", content);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<MediaUploadResponseDto>>();

            if (result != null && result.Success && result.Data != null)
            {
                _formModel.AvatarUrl = result.Data.MediaUrl;
                ToastService.ShowSuccess("Photo uploaded successfully to storage.", "Upload Complete");
            }
            else
            {
                ToastService.ShowError(result?.Message ?? "Failed to upload photo.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Upload error: {ex.Message}");
        }
        finally
        {
            _isUploading = false;
        }
    }

    private void RemoveAvatar()
    {
        _formModel.AvatarUrl = string.Empty;
    }

    private async Task HandleProfileUpdateAsync()
    {
        _isSaving = true;
        try
        {
            var response = await UserService.UpdateCurrentUserProfileAsync(_formModel);
            if (response != null && response.Success && response.Data != null)
            {
                _user = response.Data;
                ToastService.ShowSuccess("Profile information updated successfully.", "Profile Updated");
            }
            else
            {
                ToastService.ShowError(response?.Message ?? "Failed to update profile.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error updating profile: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string GetInitials(string? first, string? last)
    {
        var f = !string.IsNullOrEmpty(first) ? first[0].ToString().ToUpper() : "O";
        var l = !string.IsNullOrEmpty(last) ? last[0].ToString().ToUpper() : "P";
        return $"{f}{l}";
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
