@using SocarDispatch.Web.Models.Dispatch
@using SocarDispatch.Web.Services
@inject ICategoryService CategoryService
@inject IToastService ToastService

<div class="settings-card">
    <div class="settings-card-header">
        <div>
            <h3 class="settings-card-title">Incident Category Management</h3>
            <p class="settings-card-subtitle">Manage emergency classification categories used across incident reports and dispatch routing.</p>
        </div>
        <button type="button" class="btn btn-primary btn-sm" @onclick="OpenAddModal">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            <span>Add Category</span>
        </button>
    </div>

    <!-- Search & Stats Toolbar -->
    <div class="settings-toolbar">
        <div class="search-input-wrapper">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" class="form-control form-control-sm search-input" placeholder="Search categories..." @bind="_searchTerm" @bind:event="oninput" />
        </div>
        <span class="settings-counter">Total: <strong>@FilteredCategories.Count</strong></span>
    </div>

    <div class="settings-card-body p-0">
        @if (_isLoading)
        {
            <div class="table-loading-state">
                <div class="spinner-sm"></div>
                <span>Loading categories...</span>
            </div>
        }
        else if (FilteredCategories.Count == 0)
        {
            <div class="table-empty-state">
                <p>No categories found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="settings-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Code</th>
                            <th style="width: 220px;">Name</th>
                            <th>Description</th>
                            <th style="width: 110px;">Status</th>
                            <th style="width: 120px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in FilteredCategories)
                        {
                            <tr>
                                <td><span class="category-code-tag">@cat.Code</span></td>
                                <td class="font-weight-600">@cat.Name</td>
                                <td class="text-muted-color">@cat.Description</td>
                                <td>
                                    <button type="button" class="badge-status-btn @(cat.IsActive ? "active" : "inactive")" 
                                            @onclick="() => ToggleActiveStatusAsync(cat)" 
                                            title="Click to toggle status">
                                        @(cat.IsActive ? "Active" : "Inactive")
                                    </button>
                                </td>
                                <td style="text-align: right;">
                                    <button type="button" class="btn-action" @onclick="() => OpenEditModal(cat)" title="Edit">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 20h9"/>
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                                        </svg>
                                    </button>
                                    <button type="button" class="btn-action btn-action-danger" @onclick="() => PromptDelete(cat)" title="Delete">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Add / Edit Modal -->
@if (_isFormModalOpen)
{
    <div class="settings-modal-backdrop">
        <div class="settings-modal">
            <div class="settings-modal-header">
                <h4>@(_isEditing ? "Edit Category" : "Add New Category")</h4>
                <button type="button" class="modal-close-btn" @onclick="CloseFormModal">×</button>
            </div>
            <EditForm Model="@_formModel" OnValidSubmit="HandleFormSubmitAsync">
                <DataAnnotationsValidator />
                <div class="settings-modal-body">
                    <div class="form-group">
                        <label class="form-label">Category Code *</label>
                        <InputText class="form-control" @bind-Value="_formModel.Code" placeholder="e.g. FIRE, GAS_LEAK" />
                        <ValidationMessage For="@(() => _formModel.Code)" class="validation-message" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Category Name *</label>
                        <InputText class="form-control" @bind-Value="_formModel.Name" placeholder="e.g. Fire & Explosion" />
                        <ValidationMessage For="@(() => _formModel.Name)" class="validation-message" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="_formModel.Description" placeholder="Provide details on category scope..." />
                        <ValidationMessage For="@(() => _formModel.Description)" class="validation-message" />
                    </div>
                </div>
                <div class="settings-modal-footer">
                    <button type="button" class="btn btn-ghost" @onclick="CloseFormModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-sm"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>@(_isEditing ? "Update Category" : "Create Category")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_categoryToDelete != null)
{
    <div class="settings-modal-backdrop">
        <div class="settings-modal modal-sm">
            <div class="settings-modal-header">
                <h4>Confirm Deactivation</h4>
                <button type="button" class="modal-close-btn" @onclick="CancelDelete">×</button>
            </div>
            <div class="settings-modal-body">
                <p>Are you sure you want to deactivate/delete category <strong>@_categoryToDelete.Name (@_categoryToDelete.Code)</strong>?</p>
            </div>
            <div class="settings-modal-footer">
                <button type="button" class="btn btn-ghost" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="btn btn-primary" style="background-color: var(--color-danger); border-color: var(--color-danger);" 
                        @onclick="ConfirmDeleteAsync" disabled="@_isSubmitting">
                    Confirm Deactivate
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<IncidentCategoryDto> _categories = new();
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;

    // Modal state
    private bool _isFormModalOpen;
    private bool _isEditing;
    private Guid _editingCategoryId;
    private UpdateIncidentCategoryRequestDto _formModel = new();
    private IncidentCategoryDto? _categoryToDelete;
    private bool _isSubmitting;

    private List<IncidentCategoryDto> FilteredCategories => _categories
        .Where(c => string.IsNullOrWhiteSpace(_searchTerm) ||
                    c.Code.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    c.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderBy(c => c.Name)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        try
        {
            var response = await CategoryService.GetCategoriesAsync();
            if (response != null && response.Success && response.Data != null)
            {
                _categories = response.Data;
            }
            else
            {
                ToastService.ShowError(response?.Message ?? "Failed to load categories.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading categories: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _editingCategoryId = Guid.Empty;
        _formModel = new UpdateIncidentCategoryRequestDto();
        _isFormModalOpen = true;
    }

    private void OpenEditModal(IncidentCategoryDto cat)
    {
        _isEditing = true;
        _editingCategoryId = cat.Id;
        _formModel = new UpdateIncidentCategoryRequestDto
        {
            Code = cat.Code,
            Name = cat.Name,
            Description = cat.Description,
            IsActive = cat.IsActive
        };
        _isFormModalOpen = true;
    }

    private void CloseFormModal()
    {
        _isFormModalOpen = false;
    }

    private async Task HandleFormSubmitAsync()
    {
        _isSubmitting = true;
        try
        {
            if (_isEditing)
            {
                var response = await CategoryService.UpdateCategoryAsync(_editingCategoryId, _formModel);
                if (response != null && response.Success)
                {
                    ToastService.ShowSuccess("Category updated successfully.", "Category Updated");
                    CloseFormModal();
                    await LoadCategoriesAsync();
                }
                else
                {
                    ToastService.ShowError(response?.Message ?? "Failed to update category.");
                }
            }
            else
            {
                var createDto = new CreateIncidentCategoryRequestDto
                {
                    Code = _formModel.Code,
                    Name = _formModel.Name,
                    Description = _formModel.Description
                };
                var response = await CategoryService.CreateCategoryAsync(createDto);
                if (response != null && response.Success)
                {
                    ToastService.ShowSuccess("Category created successfully.", "Category Created");
                    CloseFormModal();
                    await LoadCategoriesAsync();
                }
                else
                {
                    ToastService.ShowError(response?.Message ?? "Failed to create category.");
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error processing category: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ToggleActiveStatusAsync(IncidentCategoryDto cat)
    {
        var updateDto = new UpdateIncidentCategoryRequestDto
        {
            Code = cat.Code,
            Name = cat.Name,
            Description = cat.Description,
            IsActive = !cat.IsActive
        };

        var response = await CategoryService.UpdateCategoryAsync(cat.Id, updateDto);
        if (response != null && response.Success)
        {
            cat.IsActive = !cat.IsActive;
            ToastService.ShowSuccess($"Category '{cat.Name}' status updated.", "Status Changed");
        }
        else
        {
            ToastService.ShowError("Failed to update status.");
        }
    }

    private void PromptDelete(IncidentCategoryDto cat)
    {
        _categoryToDelete = cat;
    }

    private void CancelDelete()
    {
        _categoryToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_categoryToDelete == null) return;
        _isSubmitting = true;
        try
        {
            var response = await CategoryService.DeleteCategoryAsync(_categoryToDelete.Id);
            if (response != null && response.Success)
            {
                ToastService.ShowSuccess("Category deactivated successfully.", "Category Deactivated");
                _categoryToDelete = null;
                await LoadCategoriesAsync();
            }
            else
            {
                ToastService.ShowError(response?.Message ?? "Failed to deactivate category.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
