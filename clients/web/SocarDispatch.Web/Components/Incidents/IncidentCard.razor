@* clients/web/SocarDispatch.Web/Components/Incidents/IncidentCard.razor *@
@using SocarDispatch.Web.Models.Dispatch

<div class="incident-card @GetCardSeverityClass(Incident.EmergencyCode)" @onclick="HandleCardClick">
    <div class="card-header">
        <div class="header-badges">
            <span class="badge-code @GetEmergencyCodeBadgeClass(Incident.EmergencyCode)">
                @Incident.EmergencyCode
            </span>
            <span class="badge-status @GetStatusBadgeClass(Incident.Status)">
                @Incident.Status
            </span>
        </div>
        <div class="card-time" title="@Incident.CreatedAt.ToString("g")">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>@Incident.TimeAgoFormatted</span>
        </div>
    </div>

    <div class="card-body">
        <h3 class="incident-category">@Incident.Category</h3>
        <p class="incident-desc">
            @(!string.IsNullOrWhiteSpace(Incident.Description) ? Incident.Description : "No additional description provided.")
        </p>
    </div>

    <div class="card-footer">
        <div class="reporter-info">
            <div class="reporter-avatar-mini">
                @GetInitials(Incident.ReporterFullName)
            </div>
            <div class="reporter-meta">
                <span class="reporter-name">@Incident.ReporterFullName</span>
                <span class="reporter-role">Reporter</span>
            </div>
        </div>

        <div class="team-assignment">
            @if (Incident.IsAssigned && !string.IsNullOrEmpty(Incident.AssignedTeamName))
            {
                <span class="team-badge assigned" title="Assigned Team">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                    </svg>
                    @Incident.AssignedTeamName
                </span>
            }
            else
            {
                <span class="team-badge unassigned">Unassigned</span>
            }

            @if (Incident.HasMedia)
            {
                <span class="media-indicator" title="@Incident.MediaAttachments.Count attachment(s)">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    @Incident.MediaAttachments.Count
                </span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IncidentDetailViewModel Incident { get; set; } = default!;

    [Parameter]
    public EventCallback<IncidentDetailViewModel> OnSelect { get; set; }

    private async Task HandleCardClick()
    {
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(Incident);
        }
    }

    private string GetCardSeverityClass(string? code)
    {
        var c = (code ?? string.Empty).ToLowerInvariant();
        if (c.Contains("red") || c.Contains("kirmizi") || c.Contains("1")) return "severity-red";
        if (c.Contains("orange") || c.Contains("turuncu") || c.Contains("2")) return "severity-orange";
        if (c.Contains("yellow") || c.Contains("sari") || c.Contains("3")) return "severity-yellow";
        if (c.Contains("green") || c.Contains("yesil") || c.Contains("4")) return "severity-green";
        return "";
    }

    private string GetEmergencyCodeBadgeClass(string? code)
    {
        var c = (code ?? string.Empty).ToLowerInvariant();
        if (c.Contains("red") || c.Contains("kirmizi") || c.Contains("1")) return "badge-code-red";
        if (c.Contains("orange") || c.Contains("turuncu") || c.Contains("2")) return "badge-code-orange";
        if (c.Contains("yellow") || c.Contains("sari") || c.Contains("3")) return "badge-code-yellow";
        if (c.Contains("green") || c.Contains("yesil") || c.Contains("4")) return "badge-code-green";
        return "badge-code-default";
    }

    private string GetStatusBadgeClass(string? status)
    {
        var s = (status ?? string.Empty).ToLowerInvariant();
        return s switch
        {
            "open" => "badge-status-open",
            "assigned" => "badge-status-assigned",
            "resolved" => "badge-status-resolved",
            "canceled" => "badge-status-canceled",
            _ => "badge-status-default"
        };
    }

    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}
