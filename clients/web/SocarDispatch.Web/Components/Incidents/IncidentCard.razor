@* clients/web/SocarDispatch.Web/Components/Incidents/IncidentCard.razor *@
@using SocarDispatch.Web.Models.Dispatch

<div class="incident-card @GetCardSeverityClass(Incident.EmergencyCode)" @onclick="HandleCardClick">
    <div class="card-header">
        <div class="header-badges">
            <span class="badge-code @GetEmergencyCodeBadgeClass(Incident.EmergencyCode)">
                @Incident.EmergencyCode
            </span>
            <span class="badge-status @GetStatusBadgeClass(Incident.Status)">
                @Incident.Status
            </span>
        </div>
        <div class="card-time" title="@Incident.CreatedAt.ToString("g")">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>@Incident.TimeAgoFormatted</span>
        </div>
    </div>

    <div class="card-body">
        <h3 class="incident-category">@Incident.Category</h3>
        <p class="incident-desc">
            @(!string.IsNullOrWhiteSpace(Incident.Description) ? Incident.Description : "No additional description provided.")
        </p>

        @* Historical Completion / Resolution Notes *@
        @if (!string.IsNullOrWhiteSpace(Incident.CompletionNotes))
        {
            <div class="card-completion-note" title="@Incident.CompletionNotes">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="note-text">@Incident.CompletionNotes</span>
            </div>
        }
    </div>

    <div class="card-footer">
        <div class="reporter-info">
            <div class="reporter-avatar-mini">
                @if (!string.IsNullOrWhiteSpace(Incident.ReporterAvatarUrl))
                {
                    <img src="@Incident.ReporterAvatarUrl" alt="@Incident.ReporterFullName" class="reporter-avatar-mini-img" />
                }
                else
                {
                    @GetInitials(Incident.ReporterFullName)
                }
            </div>
            <div class="reporter-meta">
                <span class="reporter-name">@Incident.ReporterFullName</span>
                <span class="reporter-role">@(!string.IsNullOrWhiteSpace(Incident.ReporterSubRole) ? Incident.ReporterSubRole : (!string.IsNullOrWhiteSpace(Incident.ReporterDepartment) ? Incident.ReporterDepartment : "Field Operations"))</span>
            </div>
        </div>

        <div class="team-assignment">
            @if (Incident.CompletedAt.HasValue && (Incident.Status == "Resolved" || Incident.Status == "Canceled"))
            {
                <span class="resolution-time-badge" title="Closed at @Incident.CompletedAt.Value.ToString("g")">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <span>Closed: @Incident.CompletedAt.Value.ToString("MMM dd, HH:mm")</span>
                </span>
            }

            @if (Incident.IsAssigned && !string.IsNullOrEmpty(Incident.AssignedTeamName))
            {
                <span class="team-badge assigned" title="Assigned Team">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                    </svg>
                    @Incident.AssignedTeamName
                </span>
            }
            else if (!Incident.IsHistorical)
            {
                <span class="team-badge unassigned">Unassigned</span>
            }

            @if (Incident.HasMedia)
            {
                <span class="media-indicator" title="@Incident.MediaAttachments.Count attachment(s)">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    @Incident.MediaAttachments.Count
                </span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IncidentDetailViewModel Incident { get; set; } = default!;

    [Parameter]
    public EventCallback<IncidentDetailViewModel> OnSelect { get; set; }

    private async Task HandleCardClick()
    {
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(Incident);
        }
    }

    private string GetCardSeverityClass(string? code)
    {
        var c = (code ?? string.Empty).ToLowerInvariant();
        if (c.Contains("red") || c.Contains("kirmizi") || c.Contains("1")) return "severity-red";
        if (c.Contains("orange") || c.Contains("turuncu") || c.Contains("2")) return "severity-orange";
        if (c.Contains("yellow") || c.Contains("sari") || c.Contains("3")) return "severity-yellow";
        if (c.Contains("green") || c.Contains("yesil") || c.Contains("4")) return "severity-green";
        return "";
    }

    private string GetEmergencyCodeBadgeClass(string? code)
    {
        var c = (code ?? string.Empty).ToLowerInvariant();
        if (c.Contains("red") || c.Contains("kirmizi") || c.Contains("1")) return "badge-code-red";
        if (c.Contains("orange") || c.Contains("turuncu") || c.Contains("2")) return "badge-code-orange";
        if (c.Contains("yellow") || c.Contains("sari") || c.Contains("3")) return "badge-code-yellow";
        if (c.Contains("green") || c.Contains("yesil") || c.Contains("4")) return "badge-code-green";
        return "badge-code-default";
    }

    private string GetStatusBadgeClass(string? status)
    {
        var s = (status ?? string.Empty).ToLowerInvariant();
        return s switch
        {
            "open" => "badge-status-open",
            "assigned" => "badge-status-assigned",
            "resolved" => "badge-status-resolved",
            "canceled" => "badge-status-canceled",
            _ => "badge-status-default"
        };
    }

    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}

<style>
    .reporter-info {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
    }

    .reporter-avatar-mini {
        width: 28px;
        height: 28px;
        min-width: 28px;
        border-radius: 50%;
        background-color: var(--color-accent-muted);
        color: var(--color-accent);
        font-size: 11px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .reporter-avatar-mini-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .reporter-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
    }

    .reporter-name {
        font-size: 12px;
        font-weight: 600;
        color: var(--color-text-primary);
        line-height: 1.2;
    }

    .reporter-role {
        font-size: 10px;
        color: var(--color-text-muted);
        line-height: 1.2;
    }

    .card-completion-note {
        margin-top: 8px;
        padding: 5px 8px;
        background: var(--color-surface-3, rgba(255, 255, 255, 0.04));
        border-left: 2px solid var(--color-success, #22c55e);
        border-radius: 4px;
        font-size: 11px;
        color: var(--color-text-secondary, #cbd5e1);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .card-completion-note svg {
        color: var(--color-success, #22c55e);
        flex-shrink: 0;
    }

    .note-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .resolution-time-badge {
        font-size: 10px;
        font-weight: 600;
        color: var(--color-text-muted, #8b909a);
        background: var(--color-surface-3, rgba(255, 255, 255, 0.05));
        border: 1px solid var(--color-border, #2e3138);
        padding: 2px 6px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
</style>
