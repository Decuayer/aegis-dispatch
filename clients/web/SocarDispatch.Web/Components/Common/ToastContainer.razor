@using SocarDispatch.Web.Services
@inject IToastService ToastService
@inject NavigationManager Navigation
@implements IDisposable

<div class="toast-container" aria-live="assertive">
    @foreach (var toast in _toasts)
    {
        var isActionable = !string.IsNullOrWhiteSpace(toast.ActionUrl);
        <div class="toast-card toast-@toast.Level.ToString().ToLower() @(isActionable ? "toast-actionable" : "")" 
             @key="toast.Id"
             @onclick="() => HandleToastClick(toast)">
            <div class="toast-icon">
                @switch (toast.Level)
                {
                    case ToastLevel.Danger:
                        <span>🚨</span>
                        break;
                    case ToastLevel.Success:
                        <span>✅</span>
                        break;
                    case ToastLevel.Warning:
                        <span>⚡</span>
                        break;
                    default:
                        <span>ℹ️</span>
                        break;
                }
            </div>
            <div class="toast-content">
                <div class="toast-title-row">
                    <span class="toast-title">@toast.Title</span>
                    @if (isActionable)
                    {
                        <span class="toast-action-badge">View &rarr;</span>
                    }
                </div>
                <div class="toast-message">@toast.Message</div>
            </div>
            <button class="toast-close" @onclick="() => RemoveToast(toast.Id)" @onclick:stopPropagation="true" aria-label="Close">×</button>
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnToastAdded += HandleToastAdded;
    }

    private void HandleToastAdded(ToastMessage toast)
    {
        InvokeAsync(async () =>
        {
            _toasts.Add(toast);
            StateHasChanged();

            // Auto close after duration
            await Task.Delay(toast.DurationMs);
            RemoveToast(toast.Id);
        });
    }

    private void HandleToastClick(ToastMessage toast)
    {
        if (!string.IsNullOrWhiteSpace(toast.ActionUrl))
        {
            Navigation.NavigateTo(toast.ActionUrl);
            RemoveToast(toast.Id);
        }
    }

    private void RemoveToast(Guid id)
    {
        InvokeAsync(() =>
        {
            _toasts.RemoveAll(t => t.Id == id);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ToastService.OnToastAdded -= HandleToastAdded;
    }
}

<style>
    .toast-container {
        position: fixed;
        top: 20px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 380px;
        pointer-events: none;
    }
    .toast-card {
        pointer-events: auto;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 8px;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-lg);
        animation: toast-slide-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        color: var(--color-text-primary);
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }
    .toast-card.toast-actionable {
        cursor: pointer;
    }
    .toast-card.toast-actionable:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        border-color: var(--color-accent);
    }
    .toast-card.toast-info {
        border-left: 4px solid var(--color-accent);
    }
    .toast-card.toast-success {
        border-left: 4px solid var(--color-success);
    }
    .toast-card.toast-warning {
        border-left: 4px solid var(--color-warning);
    }
    .toast-card.toast-danger {
        border-left: 4px solid var(--color-danger);
    }
    .toast-icon {
        font-size: 18px;
        line-height: 1;
        margin-top: 2px;
        flex-shrink: 0;
    }
    .toast-content {
        flex: 1;
        min-width: 0;
    }
    .toast-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 3px;
    }
    .toast-title {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.2px;
        color: var(--color-text-primary);
    }
    .toast-action-badge {
        font-size: 11px;
        font-weight: 600;
        color: var(--color-primary);
        background: rgba(227, 6, 19, 0.08);
        padding: 2px 6px;
        border-radius: 4px;
        white-space: nowrap;
    }
    .toast-message {
        font-size: 12px;
        color: var(--color-text-muted);
        line-height: 1.4;
        word-break: break-word;
    }
    .toast-close {
        background: none;
        border: none;
        color: var(--color-text-subtle);
        font-size: 18px;
        cursor: pointer;
        padding: 0 4px;
        line-height: 1;
        transition: color 0.15s ease;
        flex-shrink: 0;
    }
    .toast-close:hover {
        color: var(--color-text-primary);
    }
    @@keyframes toast-slide-in {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
</style>
