@using SocarDispatch.Web.Services
@inject IToastService ToastService
@implements IDisposable

<div class="toast-container" aria-live="assertive">
    @foreach (var toast in _toasts)
    {
        <div class="toast-card toast-@toast.Level.ToString().ToLower()" @key="toast.Id">
            <div class="toast-icon">
                @switch (toast.Level)
                {
                    case ToastLevel.Danger:
                        <span>⚠️</span>
                        break;
                    case ToastLevel.Success:
                        <span>✅</span>
                        break;
                    case ToastLevel.Warning:
                        <span>⚡</span>
                        break;
                    default:
                        <span>ℹ️</span>
                        break;
                }
            </div>
            <div class="toast-content">
                <div class="toast-title">@toast.Title</div>
                <div class="toast-message">@toast.Message</div>
            </div>
            <button class="toast-close" @onclick="() => RemoveToast(toast.Id)" aria-label="Close">×</button>
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnToastAdded += HandleToastAdded;
    }

    private void HandleToastAdded(ToastMessage toast)
    {
        InvokeAsync(async () =>
        {
            _toasts.Add(toast);
            StateHasChanged();

            // Belirlenen süre sonra otomatik kapat
            await Task.Delay(toast.DurationMs);
            RemoveToast(toast.Id);
        });
    }

    private void RemoveToast(Guid id)
    {
        InvokeAsync(() =>
        {
            _toasts.RemoveAll(t => t.Id == id);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ToastService.OnToastAdded -= HandleToastAdded;
    }
}

<style>
    .toast-container {
        position: fixed;
        top: 20px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 360px;
        pointer-events: none;
    }

    .toast-card {
        pointer-events: auto;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 8px;
        background: var(--color-surface, #1e293b);
        border: 1px solid var(--color-border, #334155);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
        animation: toast-slide-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        color: #f8fafc;
    }

    .toast-card.toast-danger {
        border-left: 4px solid #ef4444;
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, var(--color-surface, #1e293b) 100%);
    }

    .toast-card.toast-success {
        border-left: 4px solid #22c55e;
    }

    .toast-icon {
        font-size: 18px;
        line-height: 1;
        margin-top: 2px;
    }

    .toast-content {
        flex: 1;
    }

    .toast-title {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 2px;
        letter-spacing: 0.2px;
    }

    .toast-message {
        font-size: 12px;
        color: #cbd5e1;
        line-height: 1.4;
    }

    .toast-close {
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 18px;
        cursor: pointer;
        padding: 0 4px;
        line-height: 1;
    }

    .toast-close:hover {
        color: #f8fafc;
    }

    @@keyframes toast-slide-in {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
</style>
