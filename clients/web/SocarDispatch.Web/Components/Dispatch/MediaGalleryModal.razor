@* Components/Dispatch/MediaGalleryModal.razor *@
@using SocarDispatch.Web.Models.Dispatch

<div class="media-gallery-section">
    @if (MediaItems == null || !MediaItems.Any())
    {
        <div class="no-media-box">
            <span class="no-media-icon">📷</span>
            <p>No media attachments found for this incident.</p>
        </div>
    }
    else
    {
        <!-- Thumbnail Grid View -->
        <div class="media-grid">
            @for (int i = 0; i < MediaItems.Count; i++)
            {
                var index = i;
                var media = MediaItems[i];
                <div class="media-thumb-card @(media.IsVideo ? "video-thumb" : "")" @onclick="() => OpenLightbox(index)" title="Click to expand">
                    @if (media.IsPhoto)
                    {
                        <img src="@media.MediaUrl" alt="Incident Attachment" class="thumb-img" loading="lazy" />
                    }
                    else if (media.IsVideo)
                    {
                        <video src="@media.MediaUrl" class="thumb-video" preload="metadata"></video>
                        <div class="play-overlay">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                        </div>
                    }
                    <div class="media-type-badge">@(media.IsVideo ? "VIDEO" : "PHOTO")</div>
                </div>
            }
        </div>
    }

    <!-- Lightbox Modal Overlay -->
    @if (_isLightboxOpen && CurrentMedia != null)
    {
        <div class="lightbox-overlay" @onclick="CloseLightbox" @onkeydown="HandleKeyDown" tabindex="0">
            <div class="lightbox-container" @onclick:stopPropagation="true">
                <!-- Header -->
                <div class="lightbox-header">
                    <div class="lightbox-info">
                        <span class="lightbox-badge">@(CurrentMedia.IsVideo ? "VIDEO" : "PHOTO")</span>
                        <span class="lightbox-counter">@(_currentIndex + 1) / @MediaItems!.Count</span>
                    </div>
                    <button class="lightbox-close-btn" @onclick="CloseLightbox" title="Close (ESC)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>

                <!-- Media Content Area -->
                <div class="lightbox-body">
                    @if (MediaItems!.Count > 1)
                    {
                        <button class="nav-arrow left-arrow" @onclick="PreviousMedia" title="Previous">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="15 18 9 12 15 6"/>
                            </svg>
                        </button>
                    }

                    <div class="media-viewer">
                        @if (CurrentMedia.IsPhoto)
                        {
                            <img src="@CurrentMedia.MediaUrl" alt="Incident Media Fullscreen" class="full-img" />
                        }
                        else if (CurrentMedia.IsVideo)
                        {
                            <video src="@CurrentMedia.MediaUrl" controls autoplay class="full-video"></video>
                        }
                    </div>

                    @if (MediaItems!.Count > 1)
                    {
                        <button class="nav-arrow right-arrow" @onclick="NextMedia" title="Next">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<IncidentMediaViewModel> MediaItems { get; set; } = new();

    private bool _isLightboxOpen = false;
    private int _currentIndex = 0;

    private IncidentMediaViewModel? CurrentMedia =>
        MediaItems != null && _currentIndex >= 0 && _currentIndex < MediaItems.Count
            ? MediaItems[_currentIndex]
            : null;

    public void OpenLightbox(int index)
    {
        if (MediaItems == null || !MediaItems.Any()) return;
        _currentIndex = Math.Clamp(index, 0, MediaItems.Count - 1);
        _isLightboxOpen = true;
    }

    public void CloseLightbox()
    {
        _isLightboxOpen = false;
    }

    private void NextMedia()
    {
        if (MediaItems == null || MediaItems.Count <= 1) return;
        _currentIndex = (_currentIndex + 1) % MediaItems.Count;
    }

    private void PreviousMedia()
    {
        if (MediaItems == null || MediaItems.Count <= 1) return;
        _currentIndex = (_currentIndex - 1 + MediaItems.Count) % MediaItems.Count;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseLightbox();
        else if (e.Key == "ArrowRight") NextMedia();
        else if (e.Key == "ArrowLeft") PreviousMedia();
    }
}

<style>
    .media-gallery-section {
        width: 100%;
    }

    .no-media-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
        background-color: var(--color-surface-2);
        border: 1px dashed var(--color-border);
        border-radius: 8px;
        color: var(--color-text-muted);
        font-size: 13px;
        text-align: center;
    }

    .no-media-icon {
        font-size: 24px;
        margin-bottom: 6px;
        opacity: 0.6;
    }

    .media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 8px;
    }

    .media-thumb-card {
        position: relative;
        aspect-ratio: 16 / 10;
        border-radius: 6px;
        overflow: hidden;
        background-color: var(--color-surface-3);
        border: 1px solid var(--color-border);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .media-thumb-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        border-color: var(--color-accent);
    }

    .thumb-img, .thumb-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .play-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.4);
        border-radius: 6px;
    }

    .media-type-badge {
        position: absolute;
        bottom: 4px;
        right: 4px;
        font-size: 9px;
        font-weight: 700;
        padding: 1px 5px;
        border-radius: 3px;
        background: rgba(0, 0, 0, 0.7);
        color: #ffffff;
        letter-spacing: 0.5px;
    }

    /* --- Lightbox Overlay --- */
    .lightbox-overlay {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.88);
        backdrop-filter: blur(10px);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
        outline: none;
        animation: fadeIn 0.2s ease-out;
    }

    .lightbox-container {
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    .lightbox-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface-2);
    }

    .lightbox-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .lightbox-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
        background: var(--color-accent);
        color: #ffffff;
    }

    .lightbox-counter {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text-muted);
    }

    .lightbox-close-btn {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        cursor: pointer;
        padding: 4px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        transition: color 0.15s ease, background 0.15s ease;
    }

    .lightbox-close-btn:hover {
        color: var(--color-text-primary);
        background: var(--color-surface-3);
    }

    .lightbox-body {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        min-width: 320px;
        min-height: 240px;
        max-height: calc(90vh - 60px);
    }

    .media-viewer {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 100%;
        max-height: 100%;
    }

    .full-img {
        max-width: 80vw;
        max-height: 75vh;
        object-fit: contain;
        border-radius: 6px;
    }

    .full-video {
        max-width: 80vw;
        max-height: 75vh;
        border-radius: 6px;
        outline: none;
    }

    .nav-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.15s ease;
        z-index: 2;
    }

    .nav-arrow:hover {
        background: var(--color-accent);
        transform: translateY(-50%) scale(1.08);
    }

    .left-arrow { left: 24px; }
    .right-arrow { right: 24px; }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>
