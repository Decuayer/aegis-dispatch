@* Components/Dispatch/IncidentEditForm.razor *@
@using SocarDispatch.Web.Models.Dispatch
@using SocarDispatch.Web.Models.Common
@using SocarDispatch.Web.Services
@inject IIncidentService IncidentService
@inject ICategoryService CategoryService
@inject IEmergencyCodeService EmergencyCodeService
@inject IMapService MapService
@inject ISettingsService SettingsService
@inject IToastService ToastService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="incident-edit-form-container">
    <div class="edit-form-header">
        <div class="header-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            <h3>Edit Incident Details</h3>
        </div>
        <button type="button" class="btn-icon-close" @onclick="HandleCancel" title="Cancel Editing">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    </div>

    @if (_isLoadingTaxonomies)
    {
        <div class="form-loading-state">
            <span class="spinner-sm"></span>
            <span>Loading categories and emergency codes...</span>
        </div>
    }
    else
    {
        <EditForm Model="@_model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            <div class="edit-form-body">
                <!-- Category Dropdown -->
                <div class="form-group">
                    <label class="form-label required">Incident Category</label>
                    <InputSelect class="form-select" @bind-Value="_model.Category">
                        <option value="">-- Select Category --</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Code">@cat.Name (@cat.Code)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _model.Category)" class="validation-error" />
                </div>

                <!-- Emergency Code Dropdown & Real-time Badge Preview -->
                <div class="form-group">
                    <label class="form-label required">Emergency Code & Severity</label>
                    <div class="emergency-code-container">
                        <InputSelect class="form-select" @bind-Value="_model.EmergencyCode" @bind-Value:after="OnEmergencyCodeChanged">
                            <option value="">-- Select Emergency Code --</option>
                            @foreach (var ec in _emergencyCodes)
                            {
                                <option value="@ec.Code">@ec.Code (Severity @ec.SeverityLevel)</option>
                            }
                        </InputSelect>

                        @if (_selectedCodeObj != null)
                        {
                            <div class="code-preview-badge" style="background-color: @(_selectedCodeObj.ColorHex)20; border-color: @_selectedCodeObj.ColorHex; color: @_selectedCodeObj.ColorHex;">
                                <span class="badge-dot" style="background-color: @_selectedCodeObj.ColorHex;"></span>
                                <span>@_selectedCodeObj.Code</span>
                                <span class="severity-tag">Sev: @_selectedCodeObj.SeverityLevel</span>
                            </div>
                        }
                    </div>
                    <ValidationMessage For="@(() => _model.EmergencyCode)" class="validation-error" />
                </div>

                <!-- Situational Description -->
                <div class="form-group">
                    <label class="form-label">
                        Situational Description
                        <span class="char-count">@(_model.Description?.Length ?? 0)/1000</span>
                    </label>
                    <InputTextArea class="form-control text-area" 
                                   rows="3" 
                                   placeholder="Describe operational changes, hazards, casualties..."
                                   @bind-Value="_model.Description" />
                    <ValidationMessage For="@(() => _model.Description)" class="validation-error" />
                </div>

                <!-- Geospatial Location Picker -->
                <div class="form-group">
                    <div class="map-picker-header">
                        <label class="form-label required mb-0">Geospatial Location Pin</label>
                        <button type="button" class="btn-gps-locate" @onclick="LocateUserGPS" title="Center to My GPS" disabled="@_isLocating">
                            @if (_isLocating)
                            {
                                <span class="spinner-xs"></span>
                            }
                            else
                            {
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                                </svg>
                            }
                            <span>Current GPS</span>
                        </button>
                    </div>

                    <!-- Mini Leaflet Map -->
                    <div class="picker-map-wrapper">
                        <div id="@_pickerContainerId" class="picker-map-canvas"></div>
                        <div class="picker-map-hint">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="16" x2="12" y2="12"/>
                                <line x1="12" y1="8" x2="12.01" y2="8"/>
                            </svg>
                            <span>Click map or drag pin to relocate incident coordinates.</span>
                        </div>
                    </div>
                </div>

                <!-- Latitude & Longitude Inputs -->
                <div class="coordinates-row">
                    <div class="form-group flex-1">
                        <label class="form-label required">Latitude</label>
                        <input type="number" 
                               step="0.000001" 
                               class="form-control" 
                               value="@_model.Latitude" 
                               @onchange="OnLatitudeInputChanged" />
                        <ValidationMessage For="@(() => _model.Latitude)" class="validation-error" />
                    </div>

                    <div class="form-group flex-1">
                        <label class="form-label required">Longitude</label>
                        <input type="number" 
                               step="0.000001" 
                               class="form-control" 
                               value="@_model.Longitude" 
                               @onchange="OnLongitudeInputChanged" />
                        <ValidationMessage For="@(() => _model.Longitude)" class="validation-error" />
                    </div>
                </div>
            </div>

            <!-- Form Action Footer -->
            <div class="edit-form-footer">
                <button type="button" class="btn btn-ghost" @onclick="HandleCancel" disabled="@_isSubmitting">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-sm"></span>
                        <span>Saving Changes...</span>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        <span>Save Incident</span>
                    }
                </button>
            </div>
        </EditForm>
    }
</div>

<style>
    .incident-edit-form-container {
        display: flex;
        flex-direction: column;
        background: var(--color-surface, #1e293b);
        border-radius: 8px;
        animation: fadeIn 0.2s ease-out;
    }

    .edit-form-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-bottom: 1px solid var(--color-border, #334155);
        background: var(--color-surface-raised, #0f172a);
        border-radius: 8px 8px 0 0;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--color-primary, #3b82f6);
    }

    .header-left h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: var(--color-text-primary, #f8fafc);
    }

    .btn-icon-close {
        background: transparent;
        border: none;
        color: var(--color-text-muted, #94a3b8);
        cursor: pointer;
        padding: 4px;
        border-radius: 4px;
        display: flex;
        transition: all 0.2s;
    }
    .btn-icon-close:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }

    .form-loading-state {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 40px 16px;
        color: var(--color-text-muted, #94a3b8);
        font-size: 13px;
    }

    .edit-form-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--color-text-secondary, #cbd5e1);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-label.required::after {
        content: " *";
        color: var(--color-danger, #ef4444);
    }

    .char-count {
        font-size: 11px;
        color: var(--color-text-muted, #64748b);
        font-weight: normal;
    }

    .form-control, .form-select {
        background: var(--color-bg-subtle, #0f172a);
        border: 1px solid var(--color-border, #334155);
        color: var(--color-text-primary, #f8fafc);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--color-primary, #3b82f6);
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }

    .emergency-code-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .code-preview-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid;
        font-size: 12px;
        font-weight: 600;
        width: fit-content;
    }

    .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .severity-tag {
        font-size: 10px;
        opacity: 0.85;
        margin-left: 4px;
    }

    .map-picker-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2px;
    }

    .btn-gps-locate {
        background: rgba(59, 130, 246, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.4);
        color: #60a5fa;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
    }
    .btn-gps-locate:hover:not(:disabled) {
        background: rgba(59, 130, 246, 0.25);
    }

    .picker-map-wrapper {
        border: 1px solid var(--color-border, #334155);
        border-radius: 8px;
        overflow: hidden;
        background: #111;
    }

    .picker-map-canvas {
        height: 190px;
        width: 100%;
    }

    .picker-map-hint {
        padding: 6px 10px;
        background: var(--color-surface-raised, #0f172a);
        font-size: 11px;
        color: var(--color-text-muted, #94a3b8);
        display: flex;
        align-items: center;
        gap: 6px;
        border-top: 1px solid var(--color-border, #334155);
    }

    .coordinates-row {
        display: flex;
        gap: 10px;
    }

    .flex-1 { flex: 1; }

    .validation-error {
        font-size: 11px;
        color: var(--color-danger, #ef4444);
        margin-top: 2px;
    }

    .edit-form-footer {
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid var(--color-border, #334155);
        background: var(--color-surface-raised, #0f172a);
        border-radius: 0 0 8px 8px;
    }

    .btn {
        padding: 7px 14px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        border: 1px solid transparent;
    }

    .btn-ghost {
        background: transparent;
        color: var(--color-text-secondary, #cbd5e1);
        border-color: var(--color-border, #475569);
    }
    .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
    }

    .btn-primary {
        background: var(--color-primary, #3b82f6);
        color: #fff;
    }
    .btn-primary:hover:not(:disabled) {
        background: #2563eb;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .spinner-sm, .spinner-xs {
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 0.8s linear infinite;
    }
    .spinner-sm { width: 14px; height: 14px; }
    .spinner-xs { width: 10px; height: 10px; }

    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
</style>
