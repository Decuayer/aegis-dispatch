@* Components/Dispatch/IncidentSidebar.razor *@
@using SocarDispatch.Web.Models.Dispatch

<!-- Backdrop Overlay -->
@if (IsOpen)
{
    <div class="sidebar-backdrop @(IsOpen ? "visible" : "")" @onclick="CloseSidebar"></div>
}

<!-- Drawer Panel Container -->
<aside class="sidebar-drawer @(IsOpen ? "open" : "")" aria-label="Incident Details and Dispatch Panel">
    @if (_isLoading)
    {
        <div class="sidebar-loading">
            <div class="spinner-sm"></div>
            <p>Loading incident details...</p>
        </div>
    }
    else if (_incident == null)
    {
        <div class="sidebar-empty">
            <p>Select an incident from the map to view details.</p>
            <button type="button" class="btn btn-ghost" @onclick="CloseSidebar">Close</button>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="sidebar-header">
            <div class="header-top">
                <div class="badges-row">
                    <span class="badge-code @GetEmergencyCodeBadgeClass(_incident.EmergencyCode)">@_incident.EmergencyCode</span>
                    <span class="badge-status @GetStatusBadgeClass(_incident.Status)">@_incident.Status</span>
                </div>
                <button type="button" class="btn-close" @onclick="CloseSidebar" title="Close Panel (ESC)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <h2 class="incident-title">@_incident.Category</h2>
            <div class="incident-timestamp">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span>@_incident.CreatedAt.ToString("MMM dd, yyyy HH:mm") (@_incident.TimeAgoFormatted)</span>
            </div>
        </div>

        <!-- Scrollable Content Body -->
        <div class="sidebar-body">
            <!-- Reporter Card -->
            <section class="section-card">
                <div class="section-title">Reporter Information</div>
                <div class="reporter-box">
                    <div class="reporter-avatar">
                        @GetInitials(_incident.ReporterFullName)
                    </div>
                    <div class="reporter-info">
                        <strong class="reporter-name">@_incident.ReporterFullName</strong>
                        <span class="reporter-dept">@(string.IsNullOrWhiteSpace(_incident.ReporterDepartment) ? "Field Operations" : _incident.ReporterDepartment)</span>
                    </div>
                    <div class="reporter-actions">
                        @if (!string.IsNullOrWhiteSpace(_incident.ReporterPhone))
                        {
                            <a href="tel:@_incident.ReporterPhone" class="btn-contact phone" title="Call @_incident.ReporterPhone">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                                </svg>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(_incident.ReporterEmail))
                        {
                            <a href="mailto:@_incident.ReporterEmail" class="btn-contact email" title="Email @_incident.ReporterEmail">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                    <polyline points="22,6 12,13 2,6"/>
                                </svg>
                            </a>
                        }
                    </div>
                </div>
            </section>

            <!-- Collapsible Description -->
            <section class="section-card">
                <div class="collapsible-header" @onclick="ToggleDescription">
                    <div class="section-title">Situational Description</div>
                    <button type="button" class="btn-toggle">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(_isDescExpanded ? "rotated" : "")">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>
                </div>
                @if (_isDescExpanded)
                {
                    <div class="description-content">
                        <p>@(string.IsNullOrWhiteSpace(_incident.Description) ? "No additional details provided." : _incident.Description)</p>
                    </div>
                }
            </section>

            <!-- Operational Incident Status Management -->
            <section class="section-card status-actions-card">
                <div class="section-title">Incident Status Actions</div>
                <div class="status-action-buttons">
                    @if (_incident.Status is "Open" or "Assigned")
                    {
                        <button type="button" class="btn-status-action btn-resolve" @onclick="OpenResolveModal" disabled="@_isUpdatingStatus">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Mark as Resolved</span>
                        </button>
                        <button type="button" class="btn-status-action btn-cancel" @onclick="OpenCancelModal" disabled="@_isUpdatingStatus">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="15" y1="9" x2="9" y2="15"/>
                                <line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                            <span>Cancel Incident</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn-status-action btn-reopen" @onclick="ReopenIncidentAsync" disabled="@_isUpdatingStatus">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 4v6h6"/>
                                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                            </svg>
                            <span>Re-open Incident</span>
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_incident.CompletionNotes))
                {
                    <div class="completion-notes-box">
                        <div class="notes-header">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/>
                            </svg>
                            <span>Resolution / Completion Notes:</span>
                        </div>
                        <p class="notes-content">@_incident.CompletionNotes</p>
                    </div>
                }

                @if (_incident.Reports != null && _incident.Reports.Any())
                {
                    <div class="field-reports-timeline">
                        <div class="notes-header">
                            <span>Field Unit Activity Logs (@_incident.Reports.Count):</span>
                        </div>
                        @foreach (var report in _incident.Reports)
                        {
                            <div class="report-item">
                                <div class="report-meta">
                                    <strong>@report.TeamName</strong>
                                    <span>@report.ReportedAt.ToString("HH:mm")</span>
                                </div>
                                <p class="report-text">@report.Content</p>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- Media Attachments -->
            <section class="section-card">
                <div class="section-title">Media Attachments (@_incident.MediaAttachments.Count)</div>
                <MediaGalleryModal MediaItems="_incident.MediaAttachments" />
            </section>

            <!-- Response Team Section -->
            <section class="section-card">
                <div class="section-title">Response Unit Dispatch</div>
                @if (_incident.IsAssigned)
                {
                    <div class="assigned-team-banner">
                        <div class="assigned-icon">🚒</div>
                        <div>
                            <span class="assigned-label">Currently Assigned Team</span>
                            <strong class="assigned-name">@(_incident.AssignedTeamName ?? "Assigned Team")</strong>
                        </div>
                    </div>
                }
                else
                {
                    <TeamSelectionList Teams="_teams"
                                       IncidentLat="_incident.Latitude"
                                       IncidentLng="_incident.Longitude"
                                       SelectedTeamId="_selectedTeam?.Id"
                                       OnTeamSelected="HandleTeamSelected" />
                }
            </section>
        </div>

        <!-- Sticky Footer Action -->
        @if (!_incident.IsAssigned)
        {
            <div class="sidebar-footer">
                <button type="button" 
                        class="btn btn-primary btn-dispatch-action" 
                        disabled="@(_selectedTeam == null || _isDispatching)"
                        @onclick="OpenDispatchConfirmation">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 2L11 13"/>
                        <path d="M22 2l-7 20-4-9-9-4 20-7z"/>
                    </svg>
                    <span>@(_selectedTeam == null ? "Select a Team Above" : $"Dispatch {_selectedTeam.TeamName}")</span>
                </button>
            </div>
        }
    }
</aside>

<!-- Dispatch Confirmation Modal -->
<DispatchConfirmationModal IsVisible="_isConfirmationModalOpen"
                           Incident="_incident"
                           SelectedTeam="_selectedTeam"
                           OnCancel="CloseDispatchConfirmation"
                           OnConfirm="ExecuteDispatchAsync" />

<!-- Status Change Confirmation Modal -->
@if (_isStatusModalOpen)
{
    <div class="status-modal-backdrop" @onclick="() => _isStatusModalOpen = false">
        <div class="status-modal-container" @onclick:stopPropagation="true">
            <div class="status-modal-header">
                <h3 class="status-modal-title">@_statusModalTitle</h3>
                <button type="button" class="btn-close-sm" @onclick="() => _isStatusModalOpen = false">✕</button>
            </div>
            <div class="status-modal-body">
                <p class="status-modal-desc">
                    @(_targetStatus == "Resolved" 
                        ? "Are you sure you want to mark this incident as Resolved? Response teams will be returned to Idle status." 
                        : "Are you sure you want to cancel this emergency incident?")
                </p>
                <div class="form-group">
                    <label class="form-label">Optional Resolution / Operator Note:</label>
                    <textarea class="form-control text-area" rows="3" placeholder="Add resolution details, operational observations, cause..." @bind="_statusNotes"></textarea>
                </div>
            </div>
            <div class="status-modal-footer">
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _isStatusModalOpen = false">Dismiss</button>
                <button type="button" class="btn btn-sm @(_targetStatus == "Resolved" ? "btn-success-solid" : "btn-danger-solid")" @onclick="ConfirmStatusChangeAsync" disabled="@_isUpdatingStatus">
                    @if (_isUpdatingStatus)
                    {
                        <span class="spinner-sm"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Confirm @_targetStatus</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    /* Drawer Layout & Transitions */
    .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(2px);
        z-index: 1040;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .sidebar-backdrop.visible {
        opacity: 1;
        pointer-events: auto;
    }

    .sidebar-drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 440px;
        max-width: 100vw;
        background-color: var(--color-surface);
        border-left: 1px solid var(--color-border);
        box-shadow: var(--shadow-lg);
        z-index: 1050;
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sidebar-drawer.open {
        transform: translateX(0);
    }

    /* Loading / Empty States */
    .sidebar-loading, .sidebar-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding: 32px;
        text-align: center;
        gap: 16px;
        color: var(--color-text-muted);
    }

    /* Header */
    .sidebar-header {
        padding: 20px;
        border-bottom: 1px solid var(--color-border);
        background-color: var(--color-surface-2);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .badges-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-close {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        cursor: pointer;
        padding: 4px;
        border-radius: 4px;
        display: flex;
        transition: color 0.15s ease, background 0.15s ease;
    }

    .btn-close:hover {
        color: var(--color-text-primary);
        background-color: var(--color-surface-3);
    }

    .incident-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0;
    }

    .incident-timestamp {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        color: var(--color-text-muted);
    }

    /* Body */
    .sidebar-body {
        flex: 1;
        overflow-y: auto;
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .section-card {
        background-color: var(--color-surface-2);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .section-title {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--color-text-muted);
    }

    /* Reporter Box */
    .reporter-box {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .reporter-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: var(--color-accent-muted);
        color: var(--color-accent);
        font-weight: 700;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .reporter-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .reporter-name {
        font-size: 13px;
        color: var(--color-text-primary);
    }

    .reporter-dept {
        font-size: 11px;
        color: var(--color-text-muted);
    }

    .reporter-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-contact {
        padding: 7px;
        border-radius: 6px;
        background-color: var(--color-surface-3);
        color: var(--color-accent);
        border: 1px solid var(--color-border);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .btn-contact:hover {
        background-color: var(--color-accent);
        color: white;
    }

    /* Description */
    .collapsible-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
    }

    .btn-toggle {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        cursor: pointer;
        padding: 4px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .btn-toggle:hover {
        background: var(--color-surface-3);
        color: var(--color-text-primary);
    }

    .btn-toggle svg {
        transition: transform 0.2s ease;
    }

    .btn-toggle svg.rotated {
        transform: rotate(180deg);
    }

    .description-content p {
        margin: 0;
        font-size: 13px;
        color: var(--color-text-primary);
        line-height: 1.5;
        white-space: pre-wrap;
    }

    /* Status Actions */
    .status-actions-card {
        border-left: 3px solid var(--color-accent);
    }

    .status-action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-status-action {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .btn-resolve {
        background-color: rgba(34, 197, 94, 0.15);
        color: #22c55e;
        border-color: rgba(34, 197, 94, 0.3);
    }
    .btn-resolve:hover {
        background-color: #22c55e;
        color: #ffffff;
    }

    .btn-cancel {
        background-color: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        border-color: rgba(239, 68, 68, 0.3);
    }
    .btn-cancel:hover {
        background-color: #ef4444;
        color: #ffffff;
    }

    .btn-reopen {
        background-color: rgba(59, 130, 246, 0.15);
        color: #3b82f6;
        border-color: rgba(59, 130, 246, 0.3);
    }
    .btn-reopen:hover {
        background-color: #3b82f6;
        color: #ffffff;
    }

    .completion-notes-box {
        margin-top: 8px;
        padding: 10px 12px;
        background-color: var(--color-surface-3);
        border-radius: 6px;
        border: 1px solid var(--color-border);
    }

    .notes-header {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        font-weight: 700;
        color: var(--color-text-muted);
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .notes-content {
        margin: 0;
        font-size: 12px;
        color: var(--color-text-primary);
        line-height: 1.4;
    }

    .field-reports-timeline {
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .report-item {
        padding: 8px 10px;
        background-color: var(--color-surface-3);
        border-radius: 6px;
        border-left: 2px solid var(--color-accent);
    }

    .report-meta {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: var(--color-text-muted);
        margin-bottom: 2px;
    }

    .report-text {
        margin: 0;
        font-size: 12px;
        color: var(--color-text-primary);
    }

    /* Assigned Team Banner */
    .assigned-team-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background-color: var(--color-accent-muted);
        border: 1px solid var(--color-accent);
        border-radius: 6px;
    }

    .assigned-icon {
        font-size: 24px;
    }

    .assigned-label {
        font-size: 11px;
        color: var(--color-text-muted);
        display: block;
    }

    .assigned-name {
        font-size: 14px;
        color: var(--color-accent);
    }

    /* Footer */
    .sidebar-footer {
        padding: 14px 20px;
        background-color: var(--color-surface-2);
        border-top: 1px solid var(--color-border);
    }

    .btn-dispatch-action {
        width: 100%;
        padding: 12px 16px;
        font-size: 14px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    /* Status Modal Styles */
    .status-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        z-index: 1060;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .status-modal-container {
        width: 100%;
        max-width: 460px;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    .status-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        background-color: var(--color-surface-2);
        border-bottom: 1px solid var(--color-border);
    }

    .status-modal-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0;
    }

    .btn-close-sm {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        cursor: pointer;
        font-size: 14px;
    }

    .status-modal-body {
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .status-modal-desc {
        margin: 0;
        font-size: 13px;
        color: var(--color-text-muted);
    }

    .status-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 18px;
        background-color: var(--color-surface-2);
        border-top: 1px solid var(--color-border);
    }

    .btn-success-solid {
        background-color: #22c55e;
        color: #ffffff;
        border: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-success-solid:hover {
        background-color: #16a34a;
    }

    .btn-danger-solid {
        background-color: #ef4444;
        color: #ffffff;
        border: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-danger-solid:hover {
        background-color: #dc2626;
    }

    /* Badges */
    .badge-code {
        font-size: 10px;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 4px;
        color: white;
        text-transform: uppercase;
    }

    .badge-code-1 { background-color: var(--color-danger); }
    .badge-code-2 { background-color: var(--color-warning); }
    .badge-code-3 { background-color: #eab308; }

    .badge-status {
        font-size: 11px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
    }

    .badge-status-open { background: rgba(245, 158, 11, 0.15); color: var(--color-warning); }
    .badge-status-assigned { background: rgba(59, 130, 246, 0.15); color: var(--color-accent); }
    .badge-status-resolved { background: rgba(34, 197, 94, 0.15); color: var(--color-success); }
    .badge-status-canceled { background: var(--color-surface-3); color: var(--color-text-muted); }
</style>
