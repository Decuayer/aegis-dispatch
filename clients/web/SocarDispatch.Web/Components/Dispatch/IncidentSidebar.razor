@* Components/Dispatch/IncidentSidebar.razor *@
@using SocarDispatch.Web.Models.Dispatch

<!-- Backdrop Overlay -->
@if (IsOpen)
{
    <div class="sidebar-backdrop @(IsOpen ? "visible" : "")" @onclick="CloseSidebar"></div>
}

<!-- Drawer Panel Container -->
<aside class="sidebar-drawer @(IsOpen ? "open" : "")" aria-label="Incident Details and Dispatch Panel">
    @if (_isLoading)
    {
        <div class="sidebar-loading">
            <div class="spinner-sm"></div>
            <p>Loading incident details...</p>
        </div>
    }
    else if (_incident == null)
    {
        <div class="sidebar-empty">
            <p>Select an incident from the map to view details.</p>
            <button type="button" class="btn btn-ghost" @onclick="CloseSidebar">Close</button>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="sidebar-header">
            <div class="header-top">
                <div class="badges-row">
                    <span class="badge-code @GetEmergencyCodeBadgeClass(_incident.EmergencyCode)">@_incident.EmergencyCode</span>
                    <span class="badge-status @GetStatusBadgeClass(_incident.Status)">@_incident.Status</span>
                </div>
                <div class="header-actions">
                    @if (!_isEditMode && _incident.Status != "Canceled" && _incident.Status != "Resolved")
                    {
                        <button type="button" class="btn-header-edit" @onclick="() => _isEditMode = true" title="Edit Incident Details">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                            <span>Edit</span>
                        </button>
                    }
                    <button type="button" class="btn-close" @onclick="CloseSidebar" title="Close Panel (ESC)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
            </div>
            <h2 class="incident-title">@_incident.Category</h2>
            <div class="incident-timestamp">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span>@_incident.CreatedAt.ToString("MMM dd, yyyy HH:mm") (@_incident.TimeAgoFormatted)</span>
            </div>
        </div>

        <!-- Scrollable Content Body -->
        <div class="sidebar-body">
            @if (_isEditMode)
            {
                <IncidentEditForm Incident="_incident" 
                                  OnSaved="HandleIncidentSaved" 
                                  OnCancel="() => _isEditMode = false" />
            }
            else
            {
                <!-- Reporter Card -->
                <section class="section-card">
                    <div class="section-title">Reporter Information</div>
                    <div class="reporter-box">
                        <div class="reporter-avatar">
                            @if (!string.IsNullOrWhiteSpace(_incident.ReporterAvatarUrl))
                            {
                                <img src="@_incident.ReporterAvatarUrl" alt="@_incident.ReporterFullName" class="reporter-avatar-img" />
                            }
                            else
                            {
                                @GetInitials(_incident.ReporterFullName)
                            }
                        </div>
                        <div class="reporter-info">
                            <strong class="reporter-name">@_incident.ReporterFullName</strong>
                            <span class="reporter-dept">@(!string.IsNullOrWhiteSpace(_incident.ReporterSubRole) ? _incident.ReporterSubRole : (!string.IsNullOrWhiteSpace(_incident.ReporterDepartment) ? _incident.ReporterDepartment : "Field Operations"))</span>
                        </div>
                        <div class="reporter-actions">
                            @if (!string.IsNullOrWhiteSpace(_incident.ReporterPhone))
                            {
                                <a href="tel:@_incident.ReporterPhone" class="btn-contact phone" title="Call @_incident.ReporterPhone">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(_incident.ReporterEmail))
                            {
                                <a href="mailto:@_incident.ReporterEmail" class="btn-contact email" title="Email @_incident.ReporterEmail">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                        <polyline points="22,6 12,13 2,6"/>
                                    </svg>
                                </a>
                            }
                        </div>
                    </div>
                </section>

                <!-- Collapsible Description -->
                <section class="section-card">
                    <div class="collapsible-header" @onclick="ToggleDescription">
                        <div class="section-title">Situational Description</div>
                        <button type="button" class="btn-toggle">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(_isDescExpanded ? "rotated" : "")">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </button>
                    </div>
                    @if (_isDescExpanded)
                    {
                        <div class="description-content">
                            <p>@(string.IsNullOrWhiteSpace(_incident.Description) ? "No additional details provided." : _incident.Description)</p>
                        </div>
                    }
                </section>

                <!-- Operational Incident Status Management -->
                <section class="section-card status-actions-card">
                    <div class="section-title">Incident Status Actions</div>
                    <div class="status-action-buttons">
                        @if (_incident.Status is "Open" or "Assigned")
                        {
                            <button type="button" class="btn-status-action btn-resolve" @onclick="OpenResolveModal" disabled="@_isUpdatingStatus">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                <span>Mark as Resolved</span>
                            </button>
                            <button type="button" class="btn-status-action btn-cancel" @onclick="OpenCancelModal" disabled="@_isUpdatingStatus">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="15" y1="9" x2="9" y2="15"/>
                                    <line x1="9" y1="9" x2="15" y2="15"/>
                                </svg>
                                <span>Cancel Incident</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-status-action btn-reopen" @onclick="ReopenIncidentAsync" disabled="@_isUpdatingStatus">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 4v6h6"/>
                                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                                </svg>
                                <span>Re-open Incident</span>
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_incident.CompletionNotes))
                    {
                        <div class="completion-notes-box">
                            <div class="notes-header">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                </svg>
                                <span>Resolution / Completion Notes:</span>
                            </div>
                            <p class="notes-content">@_incident.CompletionNotes</p>
                        </div>
                    }

                    @if (_incident.Reports != null && _incident.Reports.Any())
                    {
                        <div class="field-reports-timeline">
                            <div class="notes-header">
                                <span>Field Unit Activity Logs (@_incident.Reports.Count):</span>
                            </div>
                            @foreach (var report in _incident.Reports)
                            {
                                <div class="report-item">
                                    <div class="report-meta">
                                        <strong>@report.TeamName</strong>
                                        <span>@report.ReportedAt.ToString("HH:mm")</span>
                                    </div>
                                    <p class="report-text">@report.Content</p>
                                </div>
                            }
                        </div>
                    }
                </section>

                <!-- Media Attachments -->
                <section class="section-card">
                    <div class="section-title">Media Attachments (@_incident.MediaAttachments.Count)</div>
                    <MediaGalleryModal MediaItems="_incident.MediaAttachments" />
                </section>

                <!-- Response Team Section -->
                <section class="section-card">
                    <div class="section-title">Response Unit Dispatch</div>
                    @if (_incident.IsAssigned)
                    {
                        <div class="assigned-team-banner">
                            <div class="assigned-icon">🚒</div>
                            <div>
                                <span class="assigned-label">Currently Assigned Team</span>
                                <strong class="assigned-name">@(_incident.AssignedTeamName ?? "Assigned Team")</strong>
                            </div>
                        </div>
                    }
                    else
                    {
                        <TeamSelectionList Teams="_teams"
                                           IncidentLat="_incident.Latitude"
                                           IncidentLng="_incident.Longitude"
                                           SelectedTeamId="_selectedTeam?.Id"
                                           OnTeamSelected="HandleTeamSelected" />
                    }
                </section>
            }
        </div>

        <!-- Sticky Footer Action -->
        @if (!_isEditMode && !_incident.IsAssigned)
        {
            <div class="sidebar-footer">
                <button type="button" 
                        class="btn btn-primary btn-dispatch-action" 
                        disabled="@(_selectedTeam == null || _isDispatching)"
                        @onclick="OpenDispatchConfirmation">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 2L11 13"/>
                        <path d="M22 2l-7 20-4-9-9-4 20-7z"/>
                    </svg>
                    <span>@(_selectedTeam == null ? "Select a Team Above" : $"Dispatch {_selectedTeam.TeamName}")</span>
                </button>
            </div>
        }
    }
</aside>

<!-- Dispatch Confirmation Modal -->
<DispatchConfirmationModal IsVisible="_isConfirmationModalOpen"
                           Incident="_incident"
                           SelectedTeam="_selectedTeam"
                           OnCancel="CloseDispatchConfirmation"
                           OnConfirm="ExecuteDispatchAsync" />

<!-- Status Change Confirmation Modal -->
@if (_isStatusModalOpen)
{
    <div class="status-modal-backdrop" @onclick="() => _isStatusModalOpen = false">
        <div class="status-modal-container" @onclick:stopPropagation="true">
            <div class="status-modal-header">
                <h3 class="status-modal-title">@_statusModalTitle</h3>
                <button type="button" class="btn-close-sm" @onclick="() => _isStatusModalOpen = false">✕</button>
            </div>
            <div class="status-modal-body">
                <p class="status-modal-desc">
                    @(_targetStatus == "Resolved" 
                        ? "Are you sure you want to mark this incident as Resolved? Response teams will be returned to Idle status." 
                        : "Are you sure you want to cancel this emergency incident?")
                </p>
                <div class="form-group">
                    <label class="form-label">Optional Resolution / Operator Note:</label>
                    <textarea class="form-control text-area" rows="3" placeholder="Add resolution details, operational observations, cause..." @bind="_statusNotes"></textarea>
                </div>
            </div>
            <div class="status-modal-footer">
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _isStatusModalOpen = false">Dismiss</button>
                <button type="button" class="btn btn-sm @(_targetStatus == "Resolved" ? "btn-success-solid" : "btn-danger-solid")" @onclick="ConfirmStatusChangeAsync" disabled="@_isUpdatingStatus">
                    @if (_isUpdatingStatus)
                    {
                        <span class="spinner-sm"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Confirm @_targetStatus</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    /* Drawer Layout & Transitions */
    .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(2px);
        z-index: 1040;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .sidebar-backdrop.visible {
        opacity: 1;
        pointer-events: auto;
    }

    .sidebar-drawer {
        position: fixed;
        top: 0;
        right: -460px;
        bottom: 0;
        width: 440px;
        max-width: 100vw;
        background-color: var(--color-surface);
        border-left: 1px solid var(--color-border);
        box-shadow: -4px 0 20px rgba(0, 0, 0, 0.4);
        z-index: 1045;
        display: flex;
        flex-direction: column;
        transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sidebar-drawer.open {
        right: 0;
    }

    .sidebar-loading, .sidebar-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
        padding: 2rem;
        gap: 1rem;
        color: var(--color-text-muted);
    }

    .sidebar-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface-raised, #131d2a);
    }

    .header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }

    .badges-row {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-header-edit {
        background: rgba(59, 130, 246, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.35);
        color: #60a5fa;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s;
    }
    .btn-header-edit:hover {
        background: rgba(59, 130, 246, 0.3);
        border-color: #3b82f6;
        color: #fff;
    }

    .badge-code, .badge-status {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-code-red { background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid #ef4444; }
    .badge-code-orange { background: rgba(249, 115, 22, 0.2); color: #f97316; border: 1px solid #f97316; }
    .badge-code-yellow { background: rgba(234, 179, 8, 0.2); color: #eab308; border: 1px solid #eab308; }
    .badge-code-green { background: rgba(34, 197, 94, 0.2); color: #22c55e; border: 1px solid #22c55e; }
    .badge-code-default { background: rgba(148, 163, 184, 0.2); color: #94a3b8; border: 1px solid #94a3b8; }

    .badge-status-open { background: rgba(239, 68, 68, 0.15); color: #f87171; }
    .badge-status-assigned { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
    .badge-status-resolved { background: rgba(34, 197, 94, 0.15); color: #4ade80; }
    .badge-status-canceled { background: rgba(100, 116, 139, 0.15); color: #94a3b8; }

    .btn-close {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        cursor: pointer;
        padding: 0.25rem;
        border-radius: 4px;
        display: flex;
        align-items: center;
        transition: color 0.2s;
    }
    .btn-close:hover {
        color: var(--color-text-primary, #fff);
    }

    .incident-title {
        margin: 0 0 0.4rem;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text-primary, #fff);
    }

    .incident-timestamp {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        color: var(--color-text-muted);
    }

    .sidebar-body {
        flex: 1;
        overflow-y: auto;
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .section-card {
        background: var(--color-surface-raised, #162232);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1rem;
    }

    .section-title {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--color-text-secondary);
        margin-bottom: 0.75rem;
    }

    .reporter-box {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .reporter-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--color-primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 600;
    }
    .reporter-avatar-img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
    }

    .reporter-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .reporter-name {
        font-size: 0.9rem;
        color: var(--color-text-primary, #fff);
    }

    .reporter-dept {
        font-size: 0.75rem;
        color: var(--color-text-muted);
    }

    .reporter-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-contact {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }
    .btn-contact:hover {
        background: var(--color-primary);
        color: #fff;
    }

    .collapsible-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
    }

    .collapsible-header .section-title {
        margin-bottom: 0;
    }

    .btn-toggle {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        cursor: pointer;
        padding: 0;
        display: flex;
    }

    .btn-toggle svg {
        transition: transform 0.2s;
    }
    .btn-toggle svg.rotated {
        transform: rotate(180deg);
    }

    .description-content {
        margin-top: 0.75rem;
        font-size: 0.85rem;
        line-height: 1.45;
        color: var(--color-text-secondary);
    }

    .status-actions-card {
        border-color: rgba(59, 130, 246, 0.2);
    }

    .status-action-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .btn-status-action {
        flex: 1;
        min-width: 130px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid transparent;
    }

    .btn-resolve {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border-color: rgba(34, 197, 94, 0.3);
    }
    .btn-resolve:hover:not(:disabled) {
        background: #22c55e;
        color: #fff;
    }

    .btn-cancel {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.3);
    }
    .btn-cancel:hover:not(:disabled) {
        background: #ef4444;
        color: #fff;
    }

    .btn-reopen {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        border-color: rgba(59, 130, 246, 0.3);
    }
    .btn-reopen:hover:not(:disabled) {
        background: #3b82f6;
        color: #fff;
    }

    .completion-notes-box {
        margin-top: 0.75rem;
        padding: 0.6rem 0.8rem;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 6px;
        border-left: 3px solid #22c55e;
    }

    .notes-header {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-text-secondary);
        margin-bottom: 0.3rem;
    }

    .notes-content {
        margin: 0;
        font-size: 0.8rem;
        color: var(--color-text-primary, #fff);
    }

    .field-reports-timeline {
        margin-top: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .report-item {
        background: rgba(0, 0, 0, 0.15);
        padding: 0.5rem 0.7rem;
        border-radius: 6px;
        border-left: 2px solid var(--color-primary);
    }

    .report-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin-bottom: 0.2rem;
    }

    .report-text {
        margin: 0;
        font-size: 0.8rem;
        color: var(--color-text-secondary);
    }

    .assigned-team-banner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.3);
        border-radius: 6px;
    }

    .assigned-icon {
        font-size: 1.5rem;
    }

    .assigned-label {
        display: block;
        font-size: 0.7rem;
        color: #4ade80;
        text-transform: uppercase;
        font-weight: 600;
    }

    .assigned-name {
        font-size: 0.9rem;
        color: var(--color-text-primary, #fff);
    }

    .sidebar-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--color-border);
        background: var(--color-surface-raised, #131d2a);
    }

    .btn-dispatch-action {
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
        font-weight: 600;
    }

    /* Modal Backdrop & Container for Status Notes */
    .status-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: 1060;
        display: flex;
        align-items: center;
