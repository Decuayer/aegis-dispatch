@* Components/Dispatch/CreateIncidentModal.razor *@
@using SocarDispatch.Web.Models.Dispatch
@using SocarDispatch.Web.Models.Common
@using SocarDispatch.Web.Services
@inject IIncidentService IncidentService
@inject ICategoryService CategoryService
@inject IEmergencyCodeService EmergencyCodeService
@inject IMapService MapService
@inject ISettingsService SettingsService
@inject IToastService ToastService
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsVisible)
{
    <div class="modal-backdrop" @onclick="HandleCancel">
        <div class="modal-card modal-lg" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="modal-title-group">
                    <div class="modal-icon-badge danger">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="modal-title">Create Emergency Incident</h3>
                        <p class="modal-subtitle">Report a new operational emergency incident into the dispatch queue.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" @onclick="HandleCancel" title="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            <!-- Modal Body with EditForm -->
            <EditForm Model="@_model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="modal-body">
                    @if (_isLoadingTaxonomies)
                    {
                        <div class="modal-loading-overlay">
                            <span class="spinner-sm"></span>
                            <span>Loading categories & emergency codes...</span>
                        </div>
                    }

                    <div class="form-grid">
                        <!-- Left Column: Taxonomies & Description -->
                        <div class="form-column">
                            <!-- Category Selection -->
                            <div class="form-group">
                                <label class="form-label required">Incident Category</label>
                                <InputSelect class="form-select" @bind-Value="_model.Category">
                                    <option value="">-- Select Incident Category --</option>
                                    @foreach (var cat in _categories)
                                    {
                                        <option value="@cat.Code">@cat.Name (@cat.Code)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _model.Category)" class="validation-error" />
                            </div>

                            <!-- Emergency Code Selection -->
                            <div class="form-group">
                                <label class="form-label required">Emergency Code & Severity</label>
                                <div class="emergency-code-selector">
                                    <InputSelect class="form-select" @bind-Value="_model.EmergencyCode" @bind-Value:after="OnEmergencyCodeChanged">
                                        <option value="">-- Select Emergency Code --</option>
                                        @foreach (var ec in _emergencyCodes)
                                        {
                                            <option value="@ec.Code">@ec.Code (Level @ec.SeverityLevel)</option>
                                        }
                                    </InputSelect>
                                    @if (_selectedCodeObj != null)
                                    {
                                        <div class="code-preview-badge" style="background-color: @(_selectedCodeObj.ColorHex)20; border-color: @_selectedCodeObj.ColorHex; color: @_selectedCodeObj.ColorHex;">
                                            <span class="badge-dot" style="background-color: @_selectedCodeObj.ColorHex;"></span>
                                            <span>@_selectedCodeObj.Code</span>
                                            <span class="severity-tag">Sev: @_selectedCodeObj.SeverityLevel</span>
                                        </div>
                                    }
                                </div>
                                <ValidationMessage For="@(() => _model.EmergencyCode)" class="validation-error" />
                            </div>

                            <!-- Description -->
                            <div class="form-group">
                                <label class="form-label">
                                    Incident Description
                                    <span class="char-count">@(_model.Description?.Length ?? 0)/1000</span>
                                </label>
                                <InputTextArea class="form-control text-area" 
                                               rows="3" 
                                               placeholder="Provide situational details, exact location cues, casualties, hazmat hazards..."
                                               @bind-Value="_model.Description" />
                                <ValidationMessage For="@(() => _model.Description)" class="validation-error" />
                            </div>

                            <!-- Media Attachments Upload -->
                            <div class="form-group">
                                <label class="form-label">Media Attachments (Photos/Videos)</label>
                                <div class="upload-area">
                                    <InputFile OnChange="HandleFileUpload" class="file-input-hidden" id="incident-media-upload" accept="image/*,video/*" multiple />
                                    <label for="incident-media-upload" class="upload-dropzone @(_isUploadingMedia ? "disabled" : "")">
                                        @if (_isUploadingMedia)
                                        {
                                            <span class="spinner-sm"></span>
                                            <span>Uploading media to storage...</span>
                                        }
                                        else
                                        {
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                                <polyline points="17 8 12 3 7 8"/>
                                                <line x1="12" y1="3" x2="12" y2="15"/>
                                            </svg>
                                            <span class="upload-text">Click to upload photo or video</span>
                                            <span class="upload-hint">PNG, JPG, MP4 up to 50MB</span>
                                        }
                                    </label>
                                </div>

                                <!-- Uploaded Media List Preview -->
                                @if (_model.MediaAttachments.Count > 0)
                                {
                                    <div class="media-preview-list">
                                        @foreach (var media in _model.MediaAttachments)
                                        {
                                            <div class="media-item-chip">
                                                <span class="media-icon">
                                                    @(media.MediaType == IncidentMediaType.Photo ? "📷" : "🎥")
                                                </span>
                                                <span class="media-filename" title="@media.MediaUrl">
                                                    @(string.IsNullOrEmpty(media.FileName) ? "Attachment" : media.FileName)
                                                </span>
                                                <button type="button" class="btn-remove-media" @onclick="() => RemoveMedia(media)">✕</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Right Column: Interactive Map Picker & Coordinates -->
                        <div class="form-column">
                            <div class="form-group">
                                <div class="map-picker-header">
                                    <label class="form-label required mb-0">Incident Geospatial Location</label>
                                    <button type="button" class="btn-gps-locate" @onclick="LocateUserGPS" title="Use My Current GPS Position" disabled="@_isLocating">
                                        @if (_isLocating)
                                        {
                                            <span class="spinner-xs"></span>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                                            </svg>
                                        }
                                        <span>Current GPS</span>
                                    </button>
                                </div>

                                <!-- Interactive Leaflet Mini Map -->
                                <div class="picker-map-wrapper">
                                    <div id="@_pickerContainerId" class="picker-map-canvas"></div>
                                    <div class="picker-map-hint">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"/>
                                            <line x1="12" y1="16" x2="12" y2="12"/>
                                            <line x1="12" y1="8" x2="12.01" y2="8"/>
                                        </svg>
                                        <span>Click map or drag pin to position incident coordinates.</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Manual Coordinate Inputs (Two-Way Synced) -->
                            <div class="coordinates-row">
                                <div class="form-group flex-1">
                                    <label class="form-label required">Latitude</label>
                                    <input type="number" 
                                           step="0.000001" 
                                           class="form-control" 
                                           value="@_model.Latitude" 
                                           @onchange="OnLatitudeInputChanged" />
                                    <ValidationMessage For="@(() => _model.Latitude)" class="validation-error" />
                                </div>

                                <div class="form-group flex-1">
                                    <label class="form-label required">Longitude</label>
                                    <input type="number" 
                                           step="0.000001" 
                                           class="form-control" 
                                           value="@_model.Longitude" 
                                           @onchange="OnLongitudeInputChanged" />
                                    <ValidationMessage For="@(() => _model.Longitude)" class="validation-error" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" @onclick="HandleCancel" disabled="@_isSubmitting">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary btn-submit-incident" disabled="@(_isSubmitting || _isUploadingMedia)">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-sm"></span>
                            <span>Reporting Incident...</span>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                            </svg>
                            <span>Report & Broadcast Incident</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 20px;
        animation: fadeIn 0.2s ease-out;
    }

    .modal-card.modal-lg {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        width: 100%;
        max-width: 920px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        animation: scaleUp 0.2s ease-out;
    }

    .modal-header {
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface-2);
    }

    .modal-title-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .modal-icon-badge.danger {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: var(--color-danger-muted);
        color: var(--color-danger);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-title {
        font-size: 17px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0;
    }

    .modal-subtitle {
        font-size: 12px;
        color: var(--color-text-muted);
        margin: 2px 0 0;
    }

    .btn-close {
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        display: flex;
        transition: all 0.2s;
    }
    .btn-close:hover {
        background: var(--color-surface-3);
        color: var(--color-text-primary);
    }

    .modal-body {
        padding: 20px 24px;
        overflow-y: auto;
        position: relative;
        flex: 1;
        background: var(--color-surface);
    }

    .modal-loading-overlay {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: var(--color-accent-muted);
        border: 1px solid var(--color-accent);
        border-radius: 6px;
        color: var(--color-accent);
        font-size: 12px;
        margin-bottom: 14px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: 20px;
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    .form-column {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--color-text-secondary);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-label.required::after {
        content: " *";
        color: var(--color-danger);
    }

    .char-count {
        font-size: 11px;
        color: var(--color-text-muted);
        font-weight: normal;
    }

    .form-control, .form-select {
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        color: var(--color-text-primary);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-select option {
        background-color: var(--color-surface);
        color: var(--color-text-primary);
    }

    .form-control:focus, .form-select:focus {
        background-color: var(--color-surface-2);
        border-color: var(--color-accent);
        box-shadow: 0 0 0 2px var(--color-accent-muted);
        color: var(--color-text-primary);
    }

    .emergency-code-selector {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .code-preview-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid;
        font-size: 12px;
        font-weight: 600;
        width: fit-content;
    }

    .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .severity-tag {
        font-size: 10px;
        opacity: 0.85;
        margin-left: 4px;
    }

    .map-picker-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 4px;
    }

    .btn-gps-locate {
        background: var(--color-accent-muted);
        border: 1px solid var(--color-accent);
        color: var(--color-accent);
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
    }
    .btn-gps-locate:hover:not(:disabled) {
        background: var(--color-accent);
        color: #fff;
    }

    .picker-map-wrapper {
        border: 1px solid var(--color-border);
        border-radius: 8px;
        overflow: hidden;
        background: var(--color-surface-2);
    }

    .picker-map-canvas {
        height: 230px;
        width: 100%;
    }

    .picker-map-hint {
        padding: 6px 10px;
        background: var(--color-surface-2);
        font-size: 11px;
        color: var(--color-text-muted);
        display: flex;
        align-items: center;
        gap: 6px;
        border-top: 1px solid var(--color-border);
    }

    .coordinates-row {
        display: flex;
        gap: 12px;
    }

    .flex-1 { flex: 1; }

    .upload-dropzone {
        border: 1px dashed var(--color-border);
        border-radius: 8px;
        padding: 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        cursor: pointer;
        background: var(--color-surface-2);
        color: var(--color-text-muted);
        transition: all 0.2s;
    }
    .upload-dropzone:hover {
        border-color: var(--color-accent);
        background: var(--color-accent-muted);
        color: var(--color-accent);
    }
    .file-input-hidden { display: none; }
    .upload-text { font-size: 12px; font-weight: 500; color: var(--color-text-primary); }
    .upload-hint { font-size: 10px; color: var(--color-text-muted); }

    .media-preview-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    .media-item-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 11px;
        color: var(--color-text-primary);
        max-width: 100%;
    }

    .media-filename {
        max-width: 140px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .btn-remove-media {
        background: transparent;
        border: none;
        color: var(--color-danger);
        cursor: pointer;
        font-size: 12px;
        padding: 0 2px;
    }

    .validation-error {
        font-size: 11px;
        color: var(--color-danger);
        margin-top: 2px;
    }

    .modal-footer {
        padding: 14px 24px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        border-top: 1px solid var(--color-border);
        background: var(--color-surface-2);
    }

    .btn {
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        border: 1px solid transparent;
    }

    .btn-ghost {
        background: transparent;
        color: var(--color-text-secondary);
        border-color: var(--color-border);
    }
    .btn-ghost:hover {
        background: var(--color-surface-3);
        color: var(--color-text-primary);
    }

    .btn-primary.btn-submit-incident {
        background: var(--color-danger);
        color: #fff;
    }
    .btn-primary.btn-submit-incident:hover:not(:disabled) {
        background: #dc2626;
        box-shadow: 0 4px 12px var(--color-danger-muted);
    }

    .spinner-sm, .spinner-xs {
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 0.8s linear infinite;
    }
    .spinner-sm { width: 14px; height: 14px; }
    .spinner-xs { width: 10px; height: 10px; }

    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes scaleUp { from { transform: scale(0.96); opacity: 0; } to { transform: scale(1); opacity: 1; } }
</style>
