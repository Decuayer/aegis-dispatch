@page "/settings"
@attribute [Authorize(Roles = "Operator")]

@using SocarDispatch.Web.Components.Settings

<PageTitle>System Settings — AegisDispatch</PageTitle>

<div class="settings-page">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">System Settings & Configuration</h1>
            <p class="page-subtitle">Configure geospatial map defaults, category rules, emergency codes, and alert preferences.</p>
        </div>
    </div>

    <!-- Settings Layout: Vertical Tabs Navigation & Content Area -->
    <div class="settings-layout">
        <!-- Sidebar Navigation Tabs -->
        <aside class="settings-sidebar-nav">
            <button type="button" class="settings-nav-item @(_activeTab == SettingsTab.Map ? "active" : "")" 
                    @onclick="() => SetActiveTab(SettingsTab.Map)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/>
                    <line x1="8" y1="2" x2="8" y2="18"/>
                    <line x1="16" y1="6" x2="16" y2="22"/>
                </svg>
                <div class="nav-text">
                    <span class="nav-title">Map & Geospatial</span>
                    <span class="nav-desc">Coordinates, zoom, and tile layer</span>
                </div>
            </button>

            <button type="button" class="settings-nav-item @(_activeTab == SettingsTab.Categories ? "active" : "")" 
                    @onclick="() => SetActiveTab(SettingsTab.Categories)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 6h16M4 12h16M4 18h7"/>
                </svg>
                <div class="nav-text">
                    <span class="nav-title">Incident Categories</span>
                    <span class="nav-desc">Classification & dispatch routing</span>
                </div>
            </button>

            <button type="button" class="settings-nav-item @(_activeTab == SettingsTab.EmergencyCodes ? "active" : "")" 
                    @onclick="() => SetActiveTab(SettingsTab.EmergencyCodes)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                    <line x1="12" y1="9" x2="12" y2="13"/>
                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
                <div class="nav-text">
                    <span class="nav-title">Emergency Codes</span>
                    <span class="nav-desc">Severity levels & color badges</span>
                </div>
            </button>

            <button type="button" class="settings-nav-item @(_activeTab == SettingsTab.Notifications ? "active" : "")" 
                    @onclick="() => SetActiveTab(SettingsTab.Notifications)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                <div class="nav-text">
                    <span class="nav-title">Notifications & Audio</span>
                    <span class="nav-desc">Sound alerts & toast duration</span>
                </div>
            </button>

            <button type="button" class="settings-nav-item @(_activeTab == SettingsTab.Profile ? "active" : "")" 
                    @onclick="() => SetActiveTab(SettingsTab.Profile)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <div class="nav-text">
                    <span class="nav-title">Operator Profile</span>
                    <span class="nav-desc">Identity & contact information</span>
                </div>
            </button>
        </aside>

        <!-- Active Tab Content Area -->
        <main class="settings-content-area">
            @switch (_activeTab)
            {
                case SettingsTab.Map:
                    <MapSettingsSection />
                    break;
                case SettingsTab.Categories:
                    <CategoryManagementSection />
                    break;
                case SettingsTab.EmergencyCodes:
                    <EmergencyCodeManagementSection />
                    break;
                case SettingsTab.Notifications:
                    <NotificationSettingsSection />
                    break;
                case SettingsTab.Profile:
                    <ProfileSettingsSection />
                    break;
            }
        </main>
    </div>
</div>

@code {
    private enum SettingsTab
    {
        Map,
        Categories,
        EmergencyCodes,
        Notifications,
        Profile
    }

    private SettingsTab _activeTab = SettingsTab.Map;

    private void SetActiveTab(SettingsTab tab)
    {
        _activeTab = tab;
    }
}
