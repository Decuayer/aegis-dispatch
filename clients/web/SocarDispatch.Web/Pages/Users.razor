@* Pages/Users.razor *@
@page "/users"
@attribute [Authorize(Roles = "Operator")]
@namespace SocarDispatch.Web.Pages

@using SocarDispatch.Web.Models.Auth
@using SocarDispatch.Web.Components.Common

<PageTitle>User Management — SOCAR Dispatch</PageTitle>

<div class="users-page-container">
    <!-- Header Section -->
    <div class="page-header">
        <div>
            <h1 class="page-title">User Management</h1>
            <p class="page-subtitle">Manage personnel accounts, operational roles, and team assignment authorizations</p>
        </div>
        <div class="header-stats">
            <div class="stat-pill">
                <span class="stat-num">@_totalCount</span>
                <span class="stat-label">Total Users</span>
            </div>
            <div class="stat-pill">
                <span class="stat-num">@_operatorCount</span>
                <span class="stat-label">Operators</span>
            </div>
            <div class="stat-pill">
                <span class="stat-num">@_teamCount</span>
                <span class="stat-label">Response Units</span>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="toolbar-card">
        <div class="search-input-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" 
                   class="form-control search-field" 
                   placeholder="Search by name, email, department, or user ID (GUID)..." 
                   value="@_searchQuery" 
                   @oninput="HandleSearchInput" />
            @if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                <button type="button" class="btn-clear-search" @onclick="ClearSearch">✕</button>
            }
        </div>

        <div class="filters-row">
            <!-- Role Filter -->
            <div class="filter-group">
                <label class="filter-label">Role:</label>
                <select class="form-select filter-select" value="@_selectedRoleFilter" @onchange="HandleRoleFilterChanged">
                    <option value="">All Roles</option>
                    <option value="Operator">Operator</option>
                    <option value="Team">Team Responder</option>
                    <option value="Employee">Employee (Reporter)</option>
                </select>
            </div>

            <!-- Department Filter -->
            <div class="filter-group">
                <label class="filter-label">Department:</label>
                <select class="form-select filter-select" value="@_selectedDeptFilter" @onchange="HandleDeptFilterChanged">
                    <option value="">All Departments</option>
                    @foreach (var dept in _departments)
                    {
                        <option value="@dept">@dept</option>
                    }
                </select>
            </div>

            <!-- Sort By -->
            <div class="filter-group">
                <label class="filter-label">Sort By:</label>
                <select class="form-select filter-select" value="@_sortBy" @onchange="HandleSortChanged">
                    <option value="name_asc">Name (A → Z)</option>
                    <option value="name_desc">Name (Z → A)</option>
                    <option value="role">Role</option>
                    <option value="dept">Department</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Users Table Card -->
    <div class="table-container-card">
        @if (_isLoading)
        {
            <div class="loading-state">
                <span class="spinner-sm"></span>
                <span>Loading users directory...</span>
            </div>
        }
        else if (_users.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">👥</div>
                <h3>No Users Found</h3>
                <p>No user accounts matched your active filters or search criteria.</p>
                @if (HasActiveFilters)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ResetFilters">Reset Filters</button>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>User Profile</th>
                            <th>Contact Information</th>
                            <th>Department</th>
                            <th>Role & Permissions</th>
                            <th>Sub-Role / Title</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _users)
                        {
                            <tr @key="user.Id">
                                <td>
                                    <div class="user-profile-cell">
                                        <div class="user-avatar @GetRoleAvatarClass(user.RoleType)">
                                            @if (!string.IsNullOrWhiteSpace(user.AvatarUrl))
                                            {
                                                <img src="@user.AvatarUrl" alt="@user.FirstName" class="avatar-img" />
                                            }
                                            else
                                            {
                                                <span>@GetInitials(user.FirstName, user.LastName)</span>
                                            }
                                        </div>
                                        <div class="user-name-col">
                                            <strong class="user-fullname">@user.FirstName @user.LastName</strong>
                                            <span class="user-id-muted">ID: @user.Id.ToString().Substring(0, 8)...</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="contact-cell">
                                        <a href="mailto:@user.Email" class="contact-link email">@user.Email</a>
                                        @if (!string.IsNullOrWhiteSpace(user.Phone))
                                        {
                                            <span class="contact-phone">📞 @user.Phone</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="dept-badge">@(string.IsNullOrWhiteSpace(user.Department) ? "General" : user.Department)</span>
                                </td>
                                <td>
                                    <span class="badge-role @GetRoleBadgeClass(user.RoleType)">
                                        @GetRoleDisplayName(user.RoleType)
                                    </span>
                                </td>
                                <td>
                                    <span class="subrole-text">@(string.IsNullOrWhiteSpace(user.SubRole) ? "—" : user.SubRole)</span>
                                </td>
                                <td class="text-right">
                                    <div class="user-actions-row">
                                        <button type="button" 
                                                class="btn btn-sm btn-edit-user" 
                                                @onclick="() => OpenEditRoleModal(user)"
                                                title="Edit Role & Permissions">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                            <span>Edit</span>
                                        </button>

                                        @if (_currentUserId != user.Id)
                                        {
                                            <button type="button" 
                                                    class="btn btn-sm btn-delete-user" 
                                                    @onclick="() => OpenDeleteModal(user)"
                                                    title="Delete User Account">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                    <line x1="10" y1="11" x2="10" y2="17"/>
                                                    <line x1="14" y1="11" x2="14" y2="17"/>
                                                </svg>
                                                <span>Delete</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" 
                                                    class="btn btn-sm btn-delete-user btn-disabled" 
                                                    disabled
                                                    title="You cannot delete your own account">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                </svg>
                                                <span>Self</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (!_isLoading && _users.Count > 0)
    {
        <!-- Reusable Pagination Bar Component -->
        <PaginationBar CurrentPage="@CurrentPage"
                       PageSize="@PageSize"
                       TotalCount="@_totalCount"
                       ItemName="users"
                       Disabled="@_isLoading"
                       OnPageChanged="HandlePageChanged"
                       OnPageSizeChanged="HandlePageSizeChanged" />
    }
</div>

<!-- Edit User Role Modal -->
@if (_isEditModalOpen && _selectedUserForEdit != null)
{
    <div class="modal-backdrop" @onclick="CloseEditModal">
        <div class="modal-card edit-user-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title-group">
                    <div class="modal-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="modal-title">Edit User Role & Permissions</h3>
                        <p class="modal-subtitle">@_selectedUserForEdit.FirstName @_selectedUserForEdit.LastName (@_selectedUserForEdit.Email)</p>
                    </div>
                </div>
                <button type="button" class="btn-close" @onclick="CloseEditModal" title="Close"></button>
            </div>

            <div class="modal-body">
                <!-- User Summary Box -->
                <div class="user-meta-summary">
                    <div class="meta-item">
                        <span class="meta-label">Department:</span>
                        <strong>@(_selectedUserForEdit.Department ?? "N/A")</strong>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Contact:</span>
                        <span>@(_selectedUserForEdit.Phone ?? "No phone registered")</span>
                    </div>
                </div>

                <!-- Role Selection -->
                <div class="form-group">
                    <label class="form-label required">System Operational Role</label>
                    <div class="role-selection-grid">
                        <label class="role-radio-card @(_editRoleModel.RoleType == RoleType.Operator ? "selected" : "")">
                            <input type="radio" name="editRoleType" 
                                   checked="@(_editRoleModel.RoleType == RoleType.Operator)" 
                                   @onchange="() => _editRoleModel.RoleType = RoleType.Operator" />
                            <div class="role-card-content">
                                <div class="role-title-row">
                                    <strong class="role-name">Operator</strong>
                                    <span class="badge-role badge-role-operator">Full Admin</span>
                                </div>
                                <span class="role-desc">Full access to dispatch board, incident triage, team management, and system settings.</span>
                            </div>
                        </label>

                        <label class="role-radio-card @(_editRoleModel.RoleType == RoleType.Team ? "selected" : "")">
                            <input type="radio" name="editRoleType" 
                                   checked="@(_editRoleModel.RoleType == RoleType.Team)" 
                                   @onchange="() => _editRoleModel.RoleType = RoleType.Team" />
                            <div class="role-card-content">
                                <div class="role-title-row">
                                    <strong class="role-name">Response Team</strong>
                                    <span class="badge-role badge-role-team">Field Unit</span>
                                </div>
                                <span class="role-desc">Field responder access. Can be assigned to response units and submit incident reports.</span>
                            </div>
                        </label>

                        <label class="role-radio-card @(_editRoleModel.RoleType == RoleType.Employee ? "selected" : "")">
                            <input type="radio" name="editRoleType" 
                                   checked="@(_editRoleModel.RoleType == RoleType.Employee)" 
                                   @onchange="() => _editRoleModel.RoleType = RoleType.Employee" />
                            <div class="role-card-content">
                                <div class="role-title-row">
                                    <strong class="role-name">Employee / Reporter</strong>
                                    <span class="badge-role badge-role-employee">Standard</span>
                                </div>
                                <span class="role-desc">Standard employee account. Can report incidents and cancel own open incidents.</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Sub-Role / Job Title Input -->
                <div class="form-group">
                    <label class="form-label">Sub-Role / Operational Title</label>
                    <input type="text" 
                           class="form-control" 
                           placeholder="e.g. Firefighter, Paramedic, Security Lead, Control Room Operator..." 
                           @bind="_editRoleModel.SubRole" />
                    <div class="subrole-presets">
                        <span class="preset-label">Quick suggestions:</span>
                        <button type="button" class="preset-chip" @onclick='() => _editRoleModel.SubRole = "Emergency Dispatcher"'>Dispatcher</button>
                        <button type="button" class="preset-chip" @onclick='() => _editRoleModel.SubRole = "Field Responder"'>Responder</button>
                        <button type="button" class="preset-chip" @onclick='() => _editRoleModel.SubRole = "Firefighter"'>Firefighter</button>
                        <button type="button" class="preset-chip" @onclick='() => _editRoleModel.SubRole = "Paramedic"'>Paramedic</button>
                        <button type="button" class="preset-chip" @onclick='() => _editRoleModel.SubRole = "Security Officer"'>Security</button>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" @onclick="CloseEditModal" disabled="@_isSavingRole">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveUserRoleAsync" disabled="@_isSavingRole">
                    @if (_isSavingRole)
                    {
                        <span class="spinner-sm"></span>
                        <span>Updating Role...</span>
                    }
                    else
                    {
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete User Confirmation Modal -->
@if (_isDeleteModalOpen && _selectedUserForDelete != null)
{
    <div class="modal-backdrop" @onclick="CloseDeleteModal">
        <div class="modal-card delete-user-modal" @onclick:stopPropagation="true">
            <div class="modal-header modal-header-danger">
                <div class="modal-title-group">
                    <div class="modal-icon modal-icon-danger">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                            <line x1="12" y1="9" x2="12" y2="13"/>
                            <line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="modal-title">Delete User Account</h3>
                        <p class="modal-subtitle">Confirm removal of personnel account</p>
                    </div>
                </div>
                <button type="button" class="btn-close" @onclick="CloseDeleteModal" title="Close"></button>
            </div>

            <div class="modal-body">
                <div class="delete-warning-box">
                    <p class="delete-warning-text">
                        Are you sure you want to delete the user account for <strong>@_selectedUserForDelete.FirstName @_selectedUserForDelete.LastName</strong>?
                    </p>
                    <div class="delete-user-details">
                        <div class="detail-row"><span class="detail-label">Email:</span> <span class="detail-val">@_selectedUserForDelete.Email</span></div>
                        <div class="detail-row"><span class="detail-label">Department:</span> <span class="detail-val">@(string.IsNullOrWhiteSpace(_selectedUserForDelete.Department) ? "General" : _selectedUserForDelete.Department)</span></div>
                        <div class="detail-row"><span class="detail-label">Role:</span> <span class="detail-val">@GetRoleDisplayName(_selectedUserForDelete.RoleType)</span></div>
                    </div>
                    <div class="delete-caution-notice">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        <span>This action is permanent. Associated team memberships and records will be detached.</span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" @onclick="CloseDeleteModal" disabled="@_isDeletingUser">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteUserAsync" disabled="@_isDeletingUser">
                    @if (_isDeletingUser)
                    {
                        <span class="spinner-sm"></span>
                        <span>Deleting User...</span>
                    }
                    else
                    {
                        <span>Confirm Deletion</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
<style>
    .users-page-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 1300px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .header-stats {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .stat-pill {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 8px 16px;
        display: flex;
        align-items: baseline;
        gap: 8px;
        box-shadow: var(--shadow-sm);
    }

    .stat-num {
        font-size: 1.2rem;
        font-weight: 700;
        color: var( --color-accent);
    }

    .stat-label {
        font-size: 0.78rem;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .toolbar-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        box-shadow: var(--shadow-sm);
    }

    .search-input-wrap {
        position: relative;
        flex: 1;
        min-width: 280px;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        color: var(--color-text-muted);
        pointer-events: none;
    }

    .search-field {
        width: 100%;
        padding: 8px 36px 8px 36px;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        color: var(--color-text-primary);
        border-radius: 8px;
        font-size: 0.88rem;
    }

    .search-field:focus {
        border-color: var(--color-accent);
        outline: none;
    }

    .btn-clear-search {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        color: var(--color-text-muted);
        cursor: pointer;
        font-size: 14px;
    }

    .filters-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .filter-label {
        font-size: 0.8rem;
        color: var(--color-text-muted);
        white-space: nowrap;
    }

    .filter-select {
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        color: var(--color-text-primary);
        padding: 6px 10px;
        border-radius: 7px;
        font-size: 0.82rem;
    }

    .table-container-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .users-table th {
        background: var(--color-surface-2);
        color: var(--color-text-muted);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 12px 18px;
        border-bottom: 1px solid var(--color-border);
    }

    .users-table td {
        padding: 14px 18px;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text-primary);
        font-size: 0.88rem;
        vertical-align: middle;
    }

    .users-table tr:last-child td {
        border-bottom: none;
    }

    .users-table tr:hover td {
        background: var(--color-surface-2);
    }

    .user-profile-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.88rem;
        overflow: hidden;
        flex-shrink: 0;
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .avatar-operator {
        background: rgba(56, 189, 248, 0.15);
        color: #0284c7;
        border: 1px solid rgba(56, 189, 248, 0.3);
    }

    .avatar-team {
        background: rgba(245, 158, 11, 0.15);
        color: #d97706;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .avatar-employee {
        background: rgba(148, 163, 184, 0.15);
        color: #64748b;
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    .user-name-col {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .user-fullname {
        color: var(--color-text-primary);
        font-size: 0.92rem;
    }

    .user-id-muted {
        font-size: 0.72rem;
        color: var(--color-text-muted);
        font-family: monospace;
    }

    .contact-cell {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .contact-link {
        color: var(--color-accent);
        text-decoration: none;
        font-size: 0.85rem;
    }

    .contact-link:hover {
        text-decoration: underline;
    }

    .contact-phone {
        font-size: 0.78rem;
        color: var(--color-text-muted);
    }

    .dept-badge {
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.78rem;
        color: var(--color-text-secondary);
    }

    .badge-role {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .badge-role-operator {
        background: rgba(56, 189, 248, 0.15);
        color: #0284c7;
        border: 1px solid rgba(56, 189, 248, 0.3);
    }

    .badge-role-team {
        background: rgba(245, 158, 11, 0.15);
        color: #d97706;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .badge-role-employee {
        background: rgba(148, 163, 184, 0.15);
        color: #64748b;
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    .subrole-text {
        font-size: 0.82rem;
        color: var(--color-text-muted);
    }

    .btn-edit-user {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        color: var(--color-text-primary);
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.15s;
    }

    .btn-edit-user:hover {
        background: var(--color-accent);
        border-color: var(--color-accent);
        color: #fff;
    }

    .user-actions-row {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-delete-user {
        display: inline-flex;
