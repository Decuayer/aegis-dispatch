@* Pages/Map.razor *@
@page "/map"
@attribute [Authorize(Roles = "Operator")]
@using SocarDispatch.Web.Components.Map
@using SocarDispatch.Web.Components.Dispatch

<PageTitle>Live Map — AegisDispatch</PageTitle>

<div class="live-map-page-container">
    <!-- Floating Top Search / Quick-Pan Bar -->
    <div class="map-floating-top">
        <MapEntityFocusBar Incidents="_incidents"
                           Teams="_teams"
                           OnIncidentFocused="HandleIncidentFocused"
                           OnTeamFocused="HandleTeamFocused" />
    </div>

        <!-- Floating Top-Right Layer & Tile Controls -->
    <div class="map-floating-controls">
        <MapControlOverlay ActiveIncidentCount="_activeIncidentsCount"
                       ResolvedIncidentCount="_resolvedIncidentsCount"
                       ActiveTeamCount="_activeTeamsCount"
                       SelectedTileProvider="@_selectedTileProvider"
                       IsBoundaryLocked="_isBoundaryLocked"
                       OnToggleIncidents="HandleToggleIncidents"
                       OnToggleResolvedIncidents="HandleToggleResolvedIncidents"
                       OnToggleTeams="HandleToggleTeams"
                       OnTileProviderChanged="HandleTileProviderChanged"
                       OnResetView="HandleResetView"
                       OnToggleBoundaryLock="HandleToggleBoundaryLock" />
    </div>



    <!-- Full-Height Interactive GIS Leaflet Map Canvas -->
    <LeafletMap @ref="_mapRef"
                Height="100%"
                OnIncidentDetailRequested="HandleIncidentDetail"
                OnAssignTeamRequested="HandleAssignTeam" />

    <!-- Operational Incident & Dispatch Sidebar Drawer (View Details) -->
    <IncidentSidebar @bind-IsOpen="_isSidebarOpen"
                     IncidentId="_selectedIncidentId"
                     OnIncidentAssigned="HandleIncidentAssigned"
                     OnIncidentUpdated="HandleIncidentUpdated" />

    <!-- Dedicated Fast Quick-Dispatch Modal (Assign Team) -->
    <QuickDispatchModal IsVisible="_isQuickDispatchOpen"
                        IncidentId="_quickDispatchIncidentId"
                        OnClose="HandleCloseQuickDispatch"
                        OnDispatched="HandleIncidentAssigned" />
</div>


<style>
    .live-map-page-container {
        position: relative;
        /* Negate page-content padding to create edge-to-edge full canvas */
        margin: -24px;
        height: calc(100vh - 52px);
        width: calc(100% + 48px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .map-floating-top {
        position: absolute;
        top: 12px;
        left: 60px;
        z-index: 1000;
    }

    .map-floating-controls {
        position: absolute;
        top: 12px;
        right: 16px;
        z-index: 1000;
    }

    @@media (max-width: 768px) {
        .live-map-page-container {
            margin: -16px;
            width: calc(100% + 32px);
            height: calc(100vh - 52px);
        }

        .map-floating-top {
            top: 10px;
            left: 56px;
            right: 10px;
            width: auto;
        }

        .map-floating-controls {
            top: 70px;
            right: 10px;
        }
    }
</style>
