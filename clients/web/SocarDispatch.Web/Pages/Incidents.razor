@* clients/web/SocarDispatch.Web/Pages/Incidents.razor *@
@page "/incidents"
@attribute [Authorize(Roles = "Operator")]

@using SocarDispatch.Web.Models.Dispatch
@using SocarDispatch.Web.Components.Incidents
@using SocarDispatch.Web.Components.Dispatch
@using SocarDispatch.Web.Components.Common

<PageTitle>Incidents Management — SOCAR Dispatch</PageTitle>

<div class="incidents-page">
    <!-- Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Incidents Management</h1>
            <p class="page-subtitle">Monitor, filter, and inspect emergency incident logs across the facility.</p>
        </div>
        <div class="header-stats">
            <span class="stat-pill">
                Showing: <strong>@_totalCount</strong> @(_selectedStatus == "All" ? "total" : _selectedStatus.ToLower()) incidents
            </span>
            <span class="stat-pill open">
                Active Open: <strong>@_statusCounts.GetValueOrDefault("Open", 0)</strong>
            </span>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <IncidentFilterToolbar 
        SelectedStatus="@_selectedStatus"
        SelectedCategory="@_selectedCategory"
        SearchTerm="@_searchTerm"
        SelectedTimeRange="@_selectedTimeRange"
        CustomFromDate="@_customFromDate"
        CustomToDate="@_customToDate"
        SelectedSort="@_selectedSort"
        StatusCounts="@_statusCounts"
        OnStatusChanged="HandleStatusChanged"
        OnCategoryChanged="HandleCategoryChanged"
        OnSearchChanged="HandleSearchChanged"
        OnTimeRangeChanged="HandleTimeRangeChanged"
        OnCustomDateRangeChanged="HandleCustomDateRangeChanged"
        OnSortChanged="HandleSortChanged"
        OnCreateIncidentRequested="HandleCreateIncident" />

    <!-- Content Area: Grid / Empty / Loading -->
    <div class="incidents-content">
        @if (_isLoading)
        {
            <div class="loading-state">
                <div class="spinner-sm"></div>
                <p>Loading incidents data...</p>
            </div>
        }
        else if (_pagedIncidents.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </div>
                <h3>No incidents found</h3>
                <p>No records match your selected filter criteria. Try adjusting the search filters or date range.</p>
                <button type="button" class="btn btn-ghost" @onclick="ResetFilters">Reset Filters</button>
            </div>
        }
        else
        {
            <!-- Cards Grid -->
            <div class="incident-grid">
                @foreach (var incident in _pagedIncidents)
                {
                    <IncidentCard @key="incident.Id" 
                                  Incident="incident" 
                                  OnSelect="HandleIncidentSelected" />
                }
            </div>

            <!-- Reusable Pagination Bar Component -->
            <PaginationBar CurrentPage="@CurrentPage"
                           PageSize="@PageSize"
                           TotalCount="@_totalCount"
                           Disabled="@_isLoading"
                           OnPageChanged="HandlePageChanged"
                           OnPageSizeChanged="HandlePageSizeChanged" />
        }
    </div>
</div>

<!-- Incident Detail & Dispatch Drawer -->
<IncidentSidebar @bind-IsOpen="_isDrawerOpen" 
                 IncidentId="_selectedIncidentId" 
                 OnIncidentAssigned="HandleIncidentAssigned"
                 OnIncidentUpdated="HandleIncidentUpdated" />

<!-- Emergency Incident Creation Modal -->
<CreateIncidentModal @bind-IsVisible="_isCreateIncidentModalOpen" 
                     OnIncidentCreated="HandleIncidentCreated" />
