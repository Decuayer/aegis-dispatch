@page "/login"
@layout EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Sign In — SOCAR Dispatch</PageTitle>

<div class="login-shell">
    <div class="login-card">

        <!-- Brand -->
        <div class="login-brand">
            <div class="login-brand-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                </svg>
            </div>
            <div>
                <div class="login-brand-name">SOCAR Dispatch</div>
                <div class="login-brand-sub">Operator Control Panel</div>
            </div>
        </div>

        <!-- Error message -->
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert-error" role="alert">@_errorMessage</div>
        }

        <!-- Form -->
        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="login-field">
                <label class="form-label" for="email">Email address</label>
                <InputText id="email"
                           class="form-control"
                           type="email"
                           placeholder="operator@socar.az"
                           @bind-Value="_loginModel.Email"
                           autocomplete="email" />
                <ValidationMessage For="@(() => _loginModel.Email)" class="validation-message" />
            </div>

            <div class="login-field">
                <label class="form-label" for="password">Password</label>
                <InputText id="password"
                           class="form-control"
                           type="password"
                           placeholder="Enter your password"
                           @bind-Value="_loginModel.Password"
                           autocomplete="current-password" />
                <ValidationMessage For="@(() => _loginModel.Password)" class="validation-message" />
            </div>

            <button type="submit" class="btn btn-primary login-submit" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-sm"></span>
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </EditForm>

        <!-- Divider -->
        <div class="divider my-4">
            <span>or</span>
        </div>

        <!-- Google OAuth -->
        <button type="button"
                class="btn btn-ghost login-google-btn"
                @onclick="HandleGoogleLogin"
                disabled="@_isSubmitting">
            <svg width="16" height="16" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            Continue with Google
        </button>

    </div>
</div>

<style>
    .login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--color-bg);
        padding: 24px;
    }

    .login-card {
        width: 100%;
        max-width: 380px;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 32px;
        box-shadow: var(--shadow-md);
    }

    .login-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--color-border);
    }

    .login-brand-icon {
        width: 40px;
        height: 40px;
        background-color: var(--color-accent);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .login-brand-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--color-text-primary);
        line-height: 1.2;
    }

    .login-brand-sub {
        font-size: 11px;
        color: var(--color-text-subtle);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 500;
        margin-top: 1px;
    }

    .alert-error {
        margin-bottom: 20px;
    }

    .login-field {
        margin-bottom: 16px;
    }

    .login-submit {
        width: 100%;
        margin-top: 8px;
        padding: 10px 16px;
        font-size: 14px;
    }

    .login-google-btn {
        width: 100%;
        padding: 10px 16px;
        font-size: 13px;
        color: var(--color-text-muted);
        gap: 8px;
    }

    .login-google-btn:hover:not(:disabled) {
        color: var(--color-text-primary);
    }
</style>

@code {
    private readonly LoginModel _loginModel = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _isSubmitting = true;
        try
        {
            var result = await AuthService.LoginAsync(_loginModel);
            if (result.Success)
                NavigationManager.NavigateTo("dashboard");
            else
                _errorMessage = result.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Task HandleGoogleLogin()
    {
        _errorMessage = "Google OAuth integration is not yet configured.";
        return Task.CompletedTask;
    }
}
