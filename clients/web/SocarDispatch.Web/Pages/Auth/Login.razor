@page "/login"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Giriş Yap | SOCAR Dispatch Panel</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="brand-header">
            <div class="logo-icon">
                ⚡
            </div>
            <h2>SOCAR DISPATCH</h2>
            <p class="subtitle">Operatör Kontrol Paneli Girişi</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                <div>⚠️ @errorMessage</div>
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="form-group mb-3">
                <label class="form-label" for="email">E-Posta Adresi</label>
                <InputText id="email" class="form-control" placeholder="operator@socar.az" @bind-Value="loginModel.Email" />
                <ValidationMessage For="@(() => loginModel.Email)" class="text-danger small mt-1" />
            </div>

            <div class="form-group mb-4">
                <label class="form-label" for="password">Şifre</label>
                <InputText id="password" type="password" class="form-control" placeholder="••••••••" @bind-Value="loginModel.Password" />
                <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small mt-1" />
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-login" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Giriş Yapılıyor...</span>
                }
                else
                {
                    <span>Giriş Yap</span>
                }
            </button>
        </EditForm>

        <div class="divider my-4">
            <span>veya</span>
        </div>

        <button type="button" class="btn btn-outline-secondary w-100 btn-google" @onclick="HandleGoogleLogin" disabled="@isSubmitting">
            <svg class="google-icon me-2" width="18" height="18" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            Google ile Giriş Yap
        </button>
    </div>
</div>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #003366 100%);
        padding: 1.5rem;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        background: rgba(30, 41, 59, 0.85);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 2.5rem 2rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        color: #f8fafc;
    }

    .brand-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .logo-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #00875a 0%, #003366 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.8rem;
        color: #ffb800;
        box-shadow: 0 4px 15px rgba(0, 135, 90, 0.4);
    }

    .brand-header h2 {
        font-weight: 700;
        letter-spacing: 1px;
        font-size: 1.5rem;
        color: #ffffff;
        margin-bottom: 0.25rem;
    }

    .subtitle {
        color: #94a3b8;
        font-size: 0.875rem;
    }

    .form-label {
        color: #cbd5e1;
        font-weight: 500;
        font-size: 0.875rem;
    }

    .form-control {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid #334155;
        color: #f8fafc;
        border-radius: 8px;
        padding: 0.75rem 1rem;
    }

    .form-control:focus {
        background: rgba(15, 23, 42, 0.8);
        border-color: #00875a;
        box-shadow: 0 0 0 3px rgba(0, 135, 90, 0.25);
        color: #ffffff;
    }

    .btn-login {
        background: linear-gradient(135deg, #00875a 0%, #006644 100%);
        border: none;
        padding: 0.75rem;
        font-weight: 600;
        border-radius: 8px;
        box-shadow: 0 4px 12px rgba(0, 135, 90, 0.3);
        transition: all 0.2s ease;
    }

    .btn-login:hover:not(:disabled) {
        background: linear-gradient(135deg, #009e6a 0%, #007a52 100%);
        transform: translateY(-1px);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #64748b;
    }

    .divider::before, .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #334155;
    }

    .divider span {
        padding: 0 0.75rem;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .btn-google {
        border-color: #334155;
        color: #e2e8f0;
        background: rgba(15, 23, 42, 0.4);
        padding: 0.75rem;
        border-radius: 8px;
    }

    .btn-google:hover:not(:disabled) {
        background: rgba(51, 65, 85, 0.6);
        color: #ffffff;
    }
</style>

@code {
    private LoginModel loginModel = new();
    private string? errorMessage;
    private bool isSubmitting = false;

    private async Task HandleLogin()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            var result = await AuthService.LoginAsync(loginModel);

            if (result.Success)
            {
                NavigationManager.NavigateTo("dashboard");
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Beklenmeyen bir hata oluştu: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleGoogleLogin()
    {
        errorMessage = "Google OAuth 2.0 kimlik doğrulama modülü hazırlanıyor...";
        await Task.CompletedTask;
    }
}
