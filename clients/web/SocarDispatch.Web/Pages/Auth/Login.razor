@page "/login"
@layout EmptyLayout
@using SocarDispatch.Web.Services.SignalR
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject IIncidentHubClient IncidentHubClient
@inject ILocationHubClient LocationHubClient
@implements IAsyncDisposable

<PageTitle>Sign In — AegisDispatch</PageTitle>

<div class="login-shell">
    <div class="login-card">

        <!-- Brand -->
        <div class="login-brand">
            <div class="login-brand-icon">
                <img src="aegis-logo.png" alt="AegisDispatch Logo" style="width: 32px; height: 32px; object-fit: contain;" />
            </div>
            <div>
                <div class="login-brand-name">AegisDispatch</div>
                <div class="login-brand-sub">Command Control Panel</div>
            </div>
        </div>

        <!-- Error message -->
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert-error" role="alert">@_errorMessage</div>
        }

        <!-- Form -->
        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="login-field">
                <label class="form-label" for="email">Email address</label>
                <InputText id="email"
                           class="form-control"
                           type="email"
                           placeholder="operator@aegisdispatch.internal"
                           @bind-Value="_loginModel.Email"
                           autocomplete="email"
                           disabled="@_isSubmitting" />
                <ValidationMessage For="@(() => _loginModel.Email)" class="validation-message" />
            </div>

            <div class="login-field">
                <label class="form-label" for="password">Password</label>
                <InputText id="password"
                           class="form-control"
                           type="password"
                           placeholder="Enter your password"
                           @bind-Value="_loginModel.Password"
                           autocomplete="current-password"
                           disabled="@_isSubmitting" />
                <ValidationMessage For="@(() => _loginModel.Password)" class="validation-message" />
            </div>

            <button type="submit" class="btn btn-primary login-submit" disabled="@_isSubmitting">
                @if (_isSubmitting && !_isGoogleAuthActive)
                {
                    <span class="spinner-sm"></span>
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </EditForm>

        <!-- Divider -->
        <div class="divider my-4">
            <span>or</span>
        </div>

        <!-- Google OAuth Official Rendered Button Container -->
        <div class="google-auth-wrapper">
            <div id="google-btn-container" class="google-btn-container"></div>

            @if (_isSubmitting && _isGoogleAuthActive)
            {
                <div class="google-loading-overlay">
                    <span class="spinner-sm"></span>
                    <span>Authenticating with Google...</span>
                </div>
            }
        </div>

    </div>
</div>

<style>
    .login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--color-bg);
        padding: 24px;
    }

    .login-card {
        width: 100%;
        max-width: 380px;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 32px;
        box-shadow: var(--shadow-md);
    }

    .login-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--color-border);
    }

    .login-brand-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .login-brand-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--color-text-primary);
        line-height: 1.2;
    }

    .login-brand-sub {
        font-size: 11px;
        color: var(--color-text-subtle);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 500;
        margin-top: 1px;
    }

    .alert-error {
        margin-bottom: 20px;
    }

    .login-field {
        margin-bottom: 16px;
    }

    .login-submit {
        width: 100%;
        margin-top: 8px;
        padding: 10px 16px;
        font-size: 14px;
    }

    .google-auth-wrapper {
        position: relative;
        width: 100%;
        min-height: 42px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .google-btn-container {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .google-btn-container iframe {
        margin: 0 auto !important;
    }

    .google-loading-overlay {
        position: absolute;
        inset: 0;
        background-color: var(--color-surface);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 6px;
        font-size: 13px;
        color: var(--color-text-muted);
        border: 1px solid var(--color-border);
        z-index: 10;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginModel _loginModel = new();
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _isGoogleAuthActive;
    private DotNetObjectReference<Login>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            var googleClientId = Configuration["Authentication:GoogleClientId"] 
                                 ?? Configuration["GoogleClientId"] 
                                 ?? string.Empty;

            try
            {
                await JSRuntime.InvokeVoidAsync("aegisGoogleAuth.init", _dotNetRef, googleClientId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[GoogleAuth] Init error: {ex.Message}");
            }
        }
    }

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _isSubmitting = true;
        _isGoogleAuthActive = false;

        try
        {
            var result = await AuthService.LoginAsync(_loginModel);
            if (result.Success)
            {
                // Re-initialize real-time hub connections
                _ = IncidentHubClient.StartAsync();
                _ = LocationHubClient.StartAsync();

                var targetUrl = !string.IsNullOrWhiteSpace(ReturnUrl) ? ReturnUrl : "dashboard";
                NavigationManager.NavigateTo(targetUrl);
            }
            else
            {
                _errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    [JSInvokable]
    public async Task OnGoogleSignInSuccess(string idToken)
    {
        _errorMessage = null;
        _isSubmitting = true;
        _isGoogleAuthActive = true;
        StateHasChanged();

        try
        {
            var result = await AuthService.GoogleLoginAsync(idToken);
            if (result.Success)
            {
                // Re-initialize real-time hub connections
                _ = IncidentHubClient.StartAsync();
                _ = LocationHubClient.StartAsync();

                var targetUrl = !string.IsNullOrWhiteSpace(ReturnUrl) ? ReturnUrl : "dashboard";
                NavigationManager.NavigateTo(targetUrl);
            }
            else
            {
                _errorMessage = result.Message ?? "Google login failed.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            _isGoogleAuthActive = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnGoogleSignInFailure(string error)
    {
        _errorMessage = error;
        _isSubmitting = false;
        _isGoogleAuthActive = false;
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
