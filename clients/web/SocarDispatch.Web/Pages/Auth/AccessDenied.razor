@page "/access-denied"
@layout EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Access Denied — SOCAR Dispatch</PageTitle>

<div class="denied-shell">
    <div class="denied-card">
        <div class="denied-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </div>

        <div class="denied-code">403</div>
        <div class="denied-title">Access Denied</div>
        <p class="denied-description">
            You do not have permission to access the Dispatch Operator Panel.
            This application is restricted to users with the <strong>Operator</strong> role.
        </p>

        <div class="denied-actions">
            <button class="btn btn-primary" @onclick="HandleLogoutAndLogin">
                Sign in with a different account
            </button>
            <button class="btn btn-ghost" @onclick="GoToLogin">
                Back to sign in
            </button>
        </div>
    </div>
</div>

<style>
    .denied-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--color-bg);
        padding: 24px;
    }

    .denied-card {
        width: 100%;
        max-width: 420px;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 40px 32px;
        box-shadow: var(--shadow-md);
        text-align: center;
    }

    .denied-icon-wrap {
        width: 56px;
        height: 56px;
        background-color: var(--color-danger-muted);
        border: 1px solid var(--color-danger);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: var(--color-danger);
    }

    .denied-code {
        font-size: 40px;
        font-weight: 800;
        color: var(--color-danger);
        line-height: 1;
        margin-bottom: 8px;
    }

    .denied-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin-bottom: 12px;
    }

    .denied-description {
        font-size: 13px;
        color: var(--color-text-muted);
        line-height: 1.6;
        margin-bottom: 28px;
    }

    .denied-description strong {
        color: var(--color-text-primary);
        font-weight: 600;
    }

    .denied-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
</style>

@code {
    private async Task HandleLogoutAndLogin()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login");
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("login");
    }
}
