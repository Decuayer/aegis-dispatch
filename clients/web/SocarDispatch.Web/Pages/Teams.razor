@* clients/web/SocarDispatch.Web/Pages/Teams.razor *@
@page "/teams"
@attribute [Authorize(Roles = "Operator")]
@namespace SocarDispatch.Web.Pages

@using SocarDispatch.Web.Models.Dispatch
@using SocarDispatch.Web.Components.Teams
@using SocarDispatch.Web.Components.Common

<PageTitle>Response Teams — AegisDispatch</PageTitle>

<div class="teams-page">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Response Teams Management</h1>
            <p class="page-subtitle">Monitor operational readiness, inspect rosters, and manage response personnel.</p>
        </div>
        <div class="header-stats">
            <span class="stat-pill">
                <span class="stat-num">@GetStatusCount("All")</span>
                <span class="stat-label">Total Units</span>
            </span>
            <span class="stat-pill idle">
                <span class="stat-num">@GetStatusCount("Idle")</span>
                <span class="stat-label">Idle (Ready)</span>
            </span>
            <span class="stat-pill forwarded">
                <span class="stat-num">@(GetStatusCount("Forwarded") + GetStatusCount("OnScene"))</span>
                <span class="stat-label">Active/En Route</span>
            </span>
        </div>
    </div>

    <!-- Toolbar: Status Filter Tabs, Search & Action -->
    <div class="teams-toolbar">
        <!-- Status Filter Tabs -->
        <div class="filter-tabs">
            <button type="button" 
                    class="tab-btn @(_selectedStatus == "All" ? "active" : "")" 
                    @onclick='() => SetStatusFilter("All")'>
                All
                <span class="tab-count">@GetStatusCount("All")</span>
            </button>
            <button type="button" 
                    class="tab-btn @(_selectedStatus == "Idle" ? "active" : "")" 
                    @onclick='() => SetStatusFilter("Idle")'>
                Idle
                <span class="tab-count count-idle">@GetStatusCount("Idle")</span>
            </button>
            <button type="button" 
                    class="tab-btn @(_selectedStatus == "Forwarded" ? "active" : "")" 
                    @onclick='() => SetStatusFilter("Forwarded")'>
                Forwarded
                <span class="tab-count count-forwarded">@GetStatusCount("Forwarded")</span>
            </button>
            <button type="button" 
                    class="tab-btn @(_selectedStatus == "OnScene" ? "active" : "")" 
                    @onclick='() => SetStatusFilter("OnScene")'>
                On Scene
                <span class="tab-count count-onscene">@GetStatusCount("OnScene")</span>
            </button>
            <button type="button" 
                    class="tab-btn @(_selectedStatus == "Busy" ? "active" : "")" 
                    @onclick='() => SetStatusFilter("Busy")'>
                Busy
                <span class="tab-count count-busy">@GetStatusCount("Busy")</span>
            </button>
        </div>

        <!-- Search & Create Button -->
        <div class="toolbar-actions">
            <div class="search-input-wrapper">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" 
                       class="form-control search-input" 
                       placeholder="Search by team name or team ID (GUID)..." 
                       value="@_searchTerm" 
                       @oninput="HandleSearchInput" />
            </div>

            <button type="button" class="btn btn-primary btn-create" @onclick="OpenCreateModal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Create New Team
            </button>
        </div>
    </div>

    <!-- Teams Grid Content -->
    <div class="teams-content">
        @if (_isLoading)
        {
            <div class="loading-state">
                <div class="spinner-sm"></div>
                <p>Loading response teams...</p>
            </div>
        }
        else if (_teams.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <h3>No response teams found</h3>
                <p>No teams match your search or filter criteria. Try adjusting the filter or create a new unit.</p>
                <button type="button" class="btn btn-ghost" @onclick="ResetFilters">Reset Filters</button>
            </div>
        }
        else
        {
            <div class="teams-grid">
                @foreach (var team in _teams)
                {
                    <TeamCard @key="team.Id" 
                              Team="team" 
                              OnSelect="HandleTeamSelected" />
                }
            </div>

            <!-- Reusable Pagination Bar Component -->
            <PaginationBar CurrentPage="@CurrentPage"
                           PageSize="@PageSize"
                           TotalCount="@_totalCount"
                           ItemName="teams"
                           Disabled="@_isLoading"
                           OnPageChanged="HandlePageChanged"
                           OnPageSizeChanged="HandlePageSizeChanged" />
        }
    </div>

    <!-- Team Detail & Management Modal -->
    <TeamDetailModal IsVisible="@_isDetailModalOpen" 
                     Team="@_selectedTeam" 
                     OnClose="CloseDetailModal" 
                     OnTeamChanged="HandleTeamUpdated" />

    <!-- Create Team Modal -->
    <CreateTeamModal IsVisible="@_isCreateModalOpen" 
                     OnClose="CloseCreateModal" 
                     OnTeamCreated="HandleTeamCreated" />
</div>
