@page "/"
@page "/dashboard"
@attribute [Authorize(Roles = "Operator")]
@using SocarDispatch.Web.Services.SignalR
@using SocarDispatch.Web.Events
@using SocarDispatch.Web.Components.Dispatch
@using SocarDispatch.Web.Components.Dashboard

@inject IIncidentHubClient IncidentHub
@inject HttpClient Http
@inject IIncidentService IncidentService
@implements IDisposable

<PageTitle>Dashboard — SOCAR Dispatch</PageTitle>

<div class="dash-header">
    <div>
        <h1 class="dash-title">Overview</h1>
        <p class="dash-sub">Real-time emergency dispatch and field team status</p>
    </div>
    <button type="button" class="btn-report-incident" @onclick="() => _isCreateModalOpen = true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <span>Report Incident</span>
    </button>
</div>

<!-- Dynamic Key Metrics -->
<div class="dash-stats">
    <!-- 1. Active Events -->
    <div class="stat-card">
        <div class="stat-label">Active Incidents</div>
        <div class="stat-value danger">
            @if (_isLoading)
            {
                <span class="stat-loading">...</span>
            }
            else
            {
                @_activeIncidents
            }
        </div>
        <div class="stat-hint">Requires immediate action</div>
    </div>

    <!-- 2. Teams Ready for Duty (Available) -->
    <div class="stat-card">
        <div class="stat-label">Available Teams</div>
        <div class="stat-value success">
            @if (_isLoading)
            {
                <span class="stat-loading">...</span>
            }
            else
            {
                @_availableTeams
            }
        </div>
        <div class="stat-hint">Ready to dispatch</div>
    </div>

    <!-- 3. Dispatched / On-Scene Teams -->
    <div class="stat-card">
        <div class="stat-label">Dispatched Teams</div>
        <div class="stat-value warning">
            @if (_isLoading)
            {
                <span class="stat-loading">...</span>
            }
            else
            {
                @_dispatchedTeams
            }
        </div>
        <div class="stat-hint">En route or on-scene</div>
    </div>

    <!-- 4. Average Response Time -->
    <div class="stat-card">
        <div class="stat-label">Avg. Response Time</div>
        <div class="stat-value">
            @if (_isLoading)
            {
                <span class="stat-loading">...</span>
            }
            else
            {
                @_avgResponseTime
            }
        </div>
        <div class="stat-hint">Last 24 hours</div>
    </div>
</div>

<!-- ——— Live Operations Grid (Map + Recent Incidents Feed) ——— -->
<div class="dash-operations-grid">
    <div class="dash-map-section">
        <div class="dash-map-header">
            <h2 class="dash-section-title">Live Operational Map</h2>
            <p class="dash-section-sub">Active incidents and field team positions in real-time</p>
        </div>
        <div class="dash-map-canvas-wrapper">
            <LeafletMap
                @ref="_leafletMapRef"
                Height="100%"
                OnIncidentDetailRequested="HandleIncidentDetail"
                OnAssignTeamRequested="HandleAssignTeam" />
        </div>
    </div>

    <div class="dash-feed-section">
        <RecentIncidentsFeed
            MaxItems="15"
            OnIncidentSelected="HandleIncidentDetail" />
    </div>
</div>

<!-- Active Incidents & Assigned Teams Relational Dispatch Board -->
<ActiveDispatchBoard
    @ref="_dispatchBoardRef"
    OnIncidentSelected="HandleIncidentDetail"
    OnQuickDispatchRequested="HandleOpenQuickDispatch" />

<!-- Operational Incident & Dispatch Sidebar Drawer -->
<IncidentSidebar @bind-IsOpen="_isSidebarOpen"
                 IncidentId="_selectedIncidentId"
                 OnIncidentAssigned="HandleIncidentAssigned"
                 OnIncidentUpdated="HandleIncidentUpdated" />

<!-- Emergency Incident Creation Modal -->
<CreateIncidentModal @bind-IsVisible="_isCreateModalOpen"
                     OnIncidentCreated="HandleIncidentCreated" />

<!-- Fast Team Dispatch Modal -->
<QuickDispatchModal IsVisible="_isQuickDispatchOpen"
                    IncidentId="_quickDispatchIncidentId"
                    OnClose="HandleCloseQuickDispatch"
                    OnDispatched="HandleQuickDispatched" />

@code {
    private int _activeIncidents = 0;
    private int _availableTeams = 0;
    private int _dispatchedTeams = 0;
    private bool _isLoading = true;
    private string _avgResponseTime = "--";
    private Guid? _selectedIncidentId;
    private bool _isSidebarOpen = false;
    private bool _isCreateModalOpen = false;
    private LeafletMap? _leafletMapRef;
    private ActiveDispatchBoard? _dispatchBoardRef;
    private bool _isQuickDispatchOpen = false;
    private Guid? _quickDispatchIncidentId;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardStatsAsync();

        // Subscribe to SignalR hub events
        IncidentHub.OnNewIncidentReceived += HandleNewIncident;
        IncidentHub.OnIncidentStatusChanged += HandleIncidentStatusChanged;
        IncidentHub.OnIncidentUpdated += HandleIncidentUpdatedRealtime;
        IncidentHub.OnTeamDispatched += HandleTeamDispatched;
    }

    private async Task LoadDashboardStatsAsync()
    {
        _isLoading = true;
        try
        {
            var incidentsResponse = await Http.GetFromJsonAsync<ApiResponse<PagedResult<MapIncidentDto>>>("api/v1/incidents?pageSize=1000");
            if (incidentsResponse?.Data?.Items != null)
            {
                _activeIncidents = incidentsResponse.Data.Items.Count(i => i.Status is "Open" or "Assigned" or "InProgress");
            }

            var teamsResponse = await Http.GetFromJsonAsync<ApiResponse<PagedResult<MapTeamDto>>>("api/v1/teams?pageSize=100");
            if (teamsResponse?.Data?.Items != null)
            {
                _availableTeams = teamsResponse.Data.Items.Count(t => t.Status == "Idle");
                _dispatchedTeams = teamsResponse.Data.Items.Count(t => t.Status is "Forwarded" or "OnScene" or "Busy");
            }

            // Calculate Dynamic Avg Response Time for the last 24 hours
            var twentyFourHoursAgo = DateTime.UtcNow.AddHours(-24);
            var recentIncidentsResponse = await IncidentService.GetAllIncidentsAsync(from: twentyFourHoursAgo);

            if (recentIncidentsResponse?.Data != null && recentIncidentsResponse.Data.Count > 0)
            {
                var assignedIncidents = recentIncidentsResponse.Data
                    .Where(i => i.AssignedAt.HasValue && i.AssignedAt.Value >= i.CreatedAt)
                    .ToList();

                if (assignedIncidents.Count > 0)
                {
                    var avgMinutes = assignedIncidents
                        .Average(i => (i.AssignedAt!.Value - i.CreatedAt).TotalMinutes);

                    _avgResponseTime = FormatResponseTime(avgMinutes);
                }
                else
                {
                    _avgResponseTime = "--";
                }
            }
            else
            {
                _avgResponseTime = "--";
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Dashboard] Failed to load dashboard stats: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatResponseTime(double? avgMinutes)
    {
        if (!avgMinutes.HasValue || double.IsNaN(avgMinutes.Value) || avgMinutes.Value < 0)
        {
            return "--";
        }

        var minutes = avgMinutes.Value;
        if (minutes < 1.0)
        {
            var seconds = (int)Math.Round(minutes * 60);
            return $"{seconds}s";
        }
        if (minutes < 60.0)
        {
            return $"{minutes:F1}m";
        }

        var hours = minutes / 60.0;
        return $"{hours:F1}h";
    }

    // SignalR Live Handlers
    private void HandleNewIncident(object? sender, NewIncidentReceivedEventArgs e)
    {
        _activeIncidents++;
        InvokeAsync(StateHasChanged);
    }

    private async void HandleIncidentStatusChanged(object? sender, IncidentStatusChangedEventArgs e)
    {
        await LoadDashboardStatsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleIncidentUpdatedRealtime(object? sender, IncidentUpdatedEventArgs e)
    {
        await LoadDashboardStatsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleTeamDispatched(object? sender, TeamDispatchedEventArgs e)
    {
        await LoadDashboardStatsAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Map & Feed & Modal Callbacks
    private void HandleIncidentDetail(Guid incidentId)
    {
        _selectedIncidentId = incidentId;
        _isSidebarOpen = true;
    }

    private void HandleAssignTeam(Guid incidentId)
    {
        HandleOpenQuickDispatch(incidentId);
    }

    private void HandleOpenQuickDispatch(Guid incidentId)
    {
        _quickDispatchIncidentId = incidentId;
        _isQuickDispatchOpen = true;
    }

    private void HandleCloseQuickDispatch()
    {
        _isQuickDispatchOpen = false;
        _quickDispatchIncidentId = null;
    }

    private async Task HandleQuickDispatched(Guid incidentId)
    {
        _isQuickDispatchOpen = false;
        _quickDispatchIncidentId = null;
        await HandleIncidentAssigned(incidentId);
        if (_dispatchBoardRef != null)
        {
            await _dispatchBoardRef.LoadBoardDataAsync();
        }
    }

    private async Task HandleIncidentCreated(IncidentDetailViewModel incident)
    {
        await LoadDashboardStatsAsync();
        if (_dispatchBoardRef != null)
        {
            await _dispatchBoardRef.LoadBoardDataAsync();
        }
    }

    private async Task HandleIncidentAssigned(Guid incidentId)
    {
        await LoadDashboardStatsAsync();
        if (_leafletMapRef != null)
        {
            await _leafletMapRef.LoadIncidentsAsync();
            await _leafletMapRef.LoadTeamsAsync();
        }
        if (_dispatchBoardRef != null)
        {
            await _dispatchBoardRef.LoadBoardDataAsync();
        }
    }

    private async Task HandleIncidentUpdated(IncidentDetailViewModel incident)
    {
        await LoadDashboardStatsAsync();
        if (_leafletMapRef != null)
        {
            await _leafletMapRef.LoadIncidentsAsync();
        }
        if (_dispatchBoardRef != null)
        {
            await _dispatchBoardRef.LoadBoardDataAsync();
        }
    }

    // Memory Cleanup
    public void Dispose()
    {
        IncidentHub.OnNewIncidentReceived -= HandleNewIncident;
        IncidentHub.OnIncidentStatusChanged -= HandleIncidentStatusChanged;
        IncidentHub.OnIncidentUpdated -= HandleIncidentUpdatedRealtime;
        IncidentHub.OnTeamDispatched -= HandleTeamDispatched;
    }
}

<style>
    .dash-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .dash-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0 0 4px;
    }

    .dash-sub {
        font-size: 13px;
        color: var(--color-text-muted);
        margin: 0;
    }

    .dash-stats {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 24px;
    }

    .stat-card {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 16px 20px;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .stat-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: var(--color-text-primary);
        line-height: 1;
        margin-bottom: 6px;
    }

    .stat-value.danger  { color: var(--color-danger); }
    .stat-value.success { color: var(--color-success); }
    .stat-value.warning { color: var(--color-warning); }

    .stat-loading {
        font-size: 20px;
        opacity: 0.5;
    }

    .stat-hint {
        font-size: 12px;
        color: var(--color-text-subtle);
    }

    /* Operations Grid (Map + Feed) */
    .dash-operations-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 20px;
        align-items: stretch;
    }

    .dash-map-section {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        min-height: 640px;
    }

    .dash-map-canvas-wrapper {
        flex: 1;
        min-height: 520px;
        height: 100%;
        border-radius: 6px;
        overflow: hidden;
        position: relative;
        border: 1px solid var(--color-border);
    }

    .dash-feed-section {
        display: flex;
        flex-direction: column;
    }

    .dash-map-header {
        margin-bottom: 16px;
    }

    .dash-section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0 0 4px;
    }

    .dash-section-sub {
        font-size: 12px;
        color: var(--color-text-muted);
        margin: 0;
    }

    .btn-report-incident {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ef4444;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-report-incident:hover {
        background: #dc2626;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    @@media (max-width: 1280px) {
        .dash-operations-grid {
            grid-template-columns: 1fr 340px;
            gap: 16px;
        }
    }

    @@media (max-width: 1024px) {
        .dash-operations-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
