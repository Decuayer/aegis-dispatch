@page "/"
@page "/dashboard"
@attribute [Authorize(Roles = "Operator")]
@using SocarDispatch.Web.Services.SignalR
@using SocarDispatch.Web.Events
@using SocarDispatch.Web.Components.Dispatch
@using SocarDispatch.Web.Components.Dashboard

@inject IIncidentHubClient IncidentHub
@inject HttpClient Http
@implements IDisposable

<PageTitle>Dashboard — SOCAR Dispatch</PageTitle>

<div class="dash-header">
    <div>
        <h1 class="dash-title">Overview</h1>
        <p class="dash-sub">Real-time emergency dispatch and field team status</p>
    </div>
    <button type="button" class="btn-report-incident" @onclick="() => _isCreateModalOpen = true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <span>Report Incident</span>
    </button>
</div>

<!-- Dynamic Key Metrics -->
<div class="dash-stats">
    <!-- 1. Active Events -->
    <div class="stat-card">
        <div class="stat-label">Active Incidents</div>
        <div class="stat-value danger">
            @if (_isLoading)
            {
                <span class="stat-loading">...</span>
            }
            else
            {
                @_activeIncidents
            }
        </div>
        <div class="stat-hint">Requires immediate action</div>
    </div>

    <!-- 2. Teams Ready for Duty (Available) -->
    <div class="stat-card">
        <div class="stat-label">Available Teams</div>
        <div class="stat-value success">
            @if (_isLoading)
            {
                <span class="stat-loading">...</span>
            }
            else
            {
                @_availableTeams
            }
        </div>
        <div class="stat-hint">Ready to dispatch</div>
    </div>

    <!-- 3. Dispatched / On-Scene Teams -->
    <div class="stat-card">
        <div class="stat-label">Dispatched Teams</div>
        <div class="stat-value warning">
            @if (_isLoading)
            {
                <span class="stat-loading">...</span>
            }
            else
            {
                @_dispatchedTeams
            }
        </div>
        <div class="stat-hint">En route or on-scene</div>
    </div>

    <!-- 4. Average Response Time -->
    <div class="stat-card">
        <div class="stat-label">Avg. Response Time</div>
        <div class="stat-value">@_avgResponseTime</div>
        <div class="stat-hint">Last 24 hours</div>
    </div>
</div>

<!-- ——— Live Operations Grid (Map + Recent Incidents Feed) ——— -->
<div class="dash-operations-grid">
    <div class="dash-map-section">
        <div class="dash-map-header">
            <h2 class="dash-section-title">Live Operational Map</h2>
            <p class="dash-section-sub">Active incidents and field team positions in real-time</p>
        </div>
        <LeafletMap
            @ref="_leafletMapRef"
            Height="580px"
            OnIncidentDetailRequested="HandleIncidentDetail"
            OnAssignTeamRequested="HandleAssignTeam" />
    </div>

    <div class="dash-feed-section">
        <RecentIncidentsFeed
            MaxItems="15"
            OnIncidentSelected="HandleIncidentDetail" />
    </div>
</div>

<!-- Operational Incident & Dispatch Sidebar Drawer -->
<IncidentSidebar @bind-IsOpen="_isSidebarOpen"
                 IncidentId="_selectedIncidentId"
                 OnIncidentAssigned="HandleIncidentAssigned"
                 OnIncidentUpdated="HandleIncidentUpdated" />

<!-- Emergency Incident Creation Modal -->
<CreateIncidentModal @bind-IsVisible="_isCreateModalOpen"
                     OnIncidentCreated="HandleIncidentCreated" />

@code {
    private int _activeIncidents = 0;
    private int _availableTeams = 0;
    private int _dispatchedTeams = 0;
    private bool _isLoading = true;
    private string _avgResponseTime = "4.2m";
    private Guid? _selectedIncidentId;
    private bool _isSidebarOpen = false;
    private bool _isCreateModalOpen = false;
    private LeafletMap? _leafletMapRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardStatsAsync();

        // Subscribe to SignalR hub events
        IncidentHub.OnNewIncidentReceived += HandleNewIncident;
        IncidentHub.OnIncidentStatusChanged += HandleIncidentStatusChanged;
        IncidentHub.OnIncidentUpdated += HandleIncidentUpdatedRealtime;
        IncidentHub.OnTeamDispatched += HandleTeamDispatched;
    }

    private async Task LoadDashboardStatsAsync()
    {
        _isLoading = true;
        try
        {
            var incidentsResponse = await Http.GetFromJsonAsync<ApiResponse<List<MapIncidentDto>>>("api/v1/incidents");
            if (incidentsResponse?.Data != null)
            {
                _activeIncidents = incidentsResponse.Data.Count(i => i.Status is "Open" or "Assigned" or "InProgress");
            }

            var teamsResponse = await Http.GetFromJsonAsync<ApiResponse<List<MapTeamDto>>>("api/v1/teams");
            if (teamsResponse?.Data != null)
            {
                _availableTeams = teamsResponse.Data.Count(t => t.Status == "Idle");
                _dispatchedTeams = teamsResponse.Data.Count(t => t.Status is "Forwarded" or "OnScene" or "Busy");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Dashboard] Failed to load dashboard stats: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    // SignalR Live Handlers
    private void HandleNewIncident(object? sender, NewIncidentReceivedEventArgs e)
    {
        _activeIncidents++;
        InvokeAsync(StateHasChanged);
    }

    private void HandleIncidentStatusChanged(object? sender, IncidentStatusChangedEventArgs e)
    {
        if (e.Status is "Resolved" or "Canceled" && e.PreviousStatus is not ("Resolved" or "Canceled"))
        {
            _activeIncidents = Math.Max(0, _activeIncidents - 1);
            InvokeAsync(StateHasChanged);
        }
    }

    private async void HandleIncidentUpdatedRealtime(object? sender, IncidentUpdatedEventArgs e)
    {
        await LoadDashboardStatsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void HandleTeamDispatched(object? sender, TeamDispatchedEventArgs e)
    {
        _availableTeams = Math.Max(0, _availableTeams - 1);
        _dispatchedTeams++;
        InvokeAsync(StateHasChanged);
    }

    // Map & Feed & Modal Callbacks
    private void HandleIncidentDetail(Guid incidentId)
    {
        _selectedIncidentId = incidentId;
        _isSidebarOpen = true;
    }

    private void HandleAssignTeam(Guid incidentId)
    {
        _selectedIncidentId = incidentId;
        _isSidebarOpen = true;
    }

    private async Task HandleIncidentCreated(IncidentDetailViewModel incident)
    {
        await LoadDashboardStatsAsync();
    }

    private async Task HandleIncidentAssigned(Guid incidentId)
    {
        await LoadDashboardStatsAsync();
        if (_leafletMapRef != null)
        {
            await _leafletMapRef.LoadIncidentsAsync();
            await _leafletMapRef.LoadTeamsAsync();
        }
    }

    private async Task HandleIncidentUpdated(IncidentDetailViewModel incident)
    {
        await LoadDashboardStatsAsync();
        if (_leafletMapRef != null)
        {
            await _leafletMapRef.LoadIncidentsAsync();
        }
    }

    // Memory Cleanup
    public void Dispose()
    {
        IncidentHub.OnNewIncidentReceived -= HandleNewIncident;
        IncidentHub.OnIncidentStatusChanged -= HandleIncidentStatusChanged;
        IncidentHub.OnIncidentUpdated -= HandleIncidentUpdatedRealtime;
        IncidentHub.OnTeamDispatched -= HandleTeamDispatched;
    }
}

<style>
    .dash-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .dash-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0 0 4px;
    }

    .dash-sub {
        font-size: 13px;
        color: var(--color-text-muted);
        margin: 0;
    }

    .dash-stats {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 24px;
    }

    .stat-card {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 16px 20px;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .stat-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: var(--color-text-primary);
        line-height: 1;
        margin-bottom: 6px;
    }

    .stat-value.danger  { color: var(--color-danger); }
    .stat-value.success { color: var(--color-success); }
    .stat-value.warning { color: var(--color-warning); }

    .stat-loading {
        font-size: 20px;
        opacity: 0.5;
    }

    .stat-hint {
        font-size: 12px;
        color: var(--color-text-subtle);
    }

    /* Operations Grid (Map + Feed) */
    .dash-operations-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 20px;
        align-items: stretch;
    }

    .dash-map-section {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
    }

    .dash-feed-section {
        display: flex;
        flex-direction: column;
    }

    .dash-map-header {
        margin-bottom: 16px;
    }

    .dash-section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0 0 4px;
    }

    .dash-section-sub {
        font-size: 12px;
        color: var(--color-text-muted);
        margin: 0;
    }

    .btn-report-incident {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ef4444;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-report-incident:hover {
        background: #dc2626;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    }

    @@media (max-width: 1280px) {
        .dash-operations-grid {
            grid-template-columns: 1fr 340px;
            gap: 16px;
        }
    }

    @@media (max-width: 1024px) {
        .dash-operations-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
